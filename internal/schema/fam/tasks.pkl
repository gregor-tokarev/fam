/// The task types of FAM.
///
/// The task types of bundles.
/// Import this module with a different name, because `tasks` is also a property name:
///
/// ```
/// import "@fam/tasks.pkl" as fam
/// ```
///
/// Paths that start with `~/` are relative to the home directory of the SSH user.
module fam.tasks

/// The wanted state of a bundle or a task.
///
/// - `"present"`: FAM installs or writes the item.
/// - `"absent"`: FAM removes the item.
typealias State = "present"|"absent"

/// The base class of all tasks.
abstract class Task {
  /// Run the task with `sudo`.
  ///
  /// On a worker, FAM runs `sudo -n`. On the cockpit, FAM asks for the password once.
  sudo: Boolean = false

  /// Units that FAM restarts once, at the end of the bundle, when this task made a change.
  ///
  /// FAM does not restart units after a failed task.
  /// FAM does not restart units for a bundle with the state `"absent"`.
  /// A unit managed by a [Service] task in the same bundle uses the scope of that task (when the
  /// bundle has a user and a system Service task with this name, the rule below applies).
  /// Other units use the system scope when [sudo] is `true`, and the user scope when it is `false`.
  restarts: Listing<String>
}

/// A task that FAM can also undo.
abstract class StateTask extends Task {
  /// The wanted state.
  ///
  /// When a bundle has the state `"absent"`, FAM undoes all its typed tasks.
  state: State = "present"
}

/// A file with a fixed content.
///
/// ```
/// new fam.File {
///   path = "~/.local/bin/hello"
///   content = read("files/hello.sh").text
///   mode = "0755"
/// }
/// ```
class File extends StateTask {
  /// The path of the file on the machine.
  path: String

  /// The full content of the file. Required when [state] is `"present"`; FAM stops otherwise.
  content: String?

  /// The file mode as an octal string, for example `"0644"`.
  mode: String(matches(Regex("0?[0-7]{3}"))) = "0644"
}

/// Keys merged into a JSON or TOML file.
///
/// FAM keeps all other keys of the file.
/// When [state] is `"absent"`, FAM removes the keys of [values] from the file.
///
/// ```
/// new fam.Merge {
///   path = "~/.cargo/config.toml"
///   format = "toml"
///   values { build { jobs = 4 } }
/// }
/// ```
class Merge extends StateTask {
  /// The path of the file on the machine.
  path: String

  /// The format of the file.
  format: "json"|"toml"

  /// The keys to merge. Nested objects merge recursively. Lists replace the old value.
  values: Dynamic

  /// The mode of a new file.
  mode: String(matches(Regex("0?[0-7]{3}"))) = "0644"
}

/// A symbolic link.
class Symlink extends StateTask {
  /// The path of the link.
  path: String

  /// The target of the link.
  target: String
}

/// A system service: a systemd unit on Linux, a launchd job on macOS.
///
/// FAM stops with an error on a machine without systemd or launchd.
class Service extends StateTask {
  /// The unit name, for example `"fleet-ports.service"`, or the launchd label.
  name: String

  /// `"user"` for a user unit or a LaunchAgent. `"system"` for a system unit or a LaunchDaemon.
  ///
  /// System units need `sudo = true`.
  scope: "user"|"system" = "user"

  /// The unit file or the launchd property list.
  ///
  /// When it is `null`, FAM does not write a file and only enables and starts the unit.
  content: String?

  /// Start the unit at boot or login.
  enabled: Boolean = true

  /// Keep the unit running.
  running: Boolean = true
}

/// Lingering for the SSH user on Linux, so that user units run without a login session.
///
/// The default of [sudo] is `true`, because `loginctl enable-linger` usually needs root.
class Linger extends StateTask {
  sudo = true

  /// The user. When it is `null`, FAM uses the SSH user.
  user: String?
}

/// A package manager for [Package.package].
///
/// - `"npm"`, `"bun"`, `"vite"` (Vite+ `vp install -g`): global JavaScript packages, as the user.
/// - `"uv"`, `"cargo"`, `"go"`: user tools, without sudo.
/// - `"system"`: brew on macOS, or the package manager of the Linux distribution.
/// - `"brew"`: Homebrew, as the user.
/// - `"apt"`, `"dnf"`, `"pacman"`, `"apk"`: the OS package manager. FAM runs it with `sudo`.
/// - `"yay"`: AUR packages on Arch Linux, as the user (yay runs `sudo` itself).
typealias Manager = "uv"|"cargo"|"go"|"system"|"npm"|"bun"|"vite"|"brew"|"apt"|"dnf"|"pacman"|"yay"|"apk"

/// A package with its package manager.
///
/// ```
/// package = new { package = "agent-browser"; manager = "brew" }
/// ```
class PackageRef {
  /// The package name, for example `"agent-browser"` or `"@railway/cli"`.
  package: String

  /// The package manager.
  manager: Manager = "npm"

  /// Package names for specific managers, for example `names { ["apt"] = "fd-find" }`.
  /// FAM uses [package] when the selected manager has no name here.
  names: Mapping<Manager, String(!isEmpty)>
}

/// A command line program.
///
/// Give a [package], and FAM installs, updates, and removes it with a package manager:
///
/// ```
/// new fam.Package { package = "agent-browser" }                                   // npm
/// new fam.Package { package = new { package = "agent-browser"; manager = "brew" } }
/// ```
///
/// Or give your own commands: [install], [update], [uninstall].
///
/// FAM installs the program when it is missing. `fam apply` runs the update only when a verify
/// script of the bundle fails before the apply loop. `fam apply --update` runs each update.
/// An update changes nothing in the result when the output of [versionCommand] stays the same.
class Package extends StateTask {
  /// The package. A string is an npm package. An object (`new { package = …; manager = … }`
  /// or a [PackageRef]) selects the package manager.
  package: (String|PackageRef|Dynamic)?

  /// The name of the program in `PATH`, or its path (for example `"~/.local/bin/tool"`).
  ///
  /// When it is `null`, FAM uses the package name without its npm scope (`@railway/cli` gives `cli`).
  binary: String?

  /// The install command. Required when [package] is `null`.
  install: String?((this != null) || (package != null))

  /// The update command. When it is `null` and [package] is `null`, FAM does not update the program.
  update: String?

  /// The uninstall command. Required to remove a package without [package].
  uninstall: String?

  /// A command that prints the installed version. When it is `null`, FAM runs `<binary> --version`.
  versionCommand: String?
}

/// A shell script with a check.
///
/// FAM cannot undo a script.
///
/// Exit codes of [check]:
/// - `0`: satisfied. FAM does not run [apply].
/// - `100`: changes required. FAM runs [apply], then runs [check] again.
/// - any other code: error. FAM never runs [apply] after an error.
///
/// FAM rejects a script without [check] or [creates].
class Script extends Task {
  /// The name of the script in output.
  name: String

  /// The check command. See the exit codes above.
  check: String?

  /// A short form of a check: the script is satisfied when this path exists.
  creates: String?

  /// The apply command.
  apply: String(check != null || creates != null)
}

/// An agent skill: a folder with `SKILL.md`, from a folder on the cockpit or from a URL.
///
/// ```
/// new fam.AgentSkill { source = "skills/release-notes" }
/// new fam.AgentSkill { source = "https://github.com/vercel-labs/agent-browser"; path = "skills/agent-browser" }
/// new fam.AgentSkill { source = "https://github.com/anthropics/skills/tree/main/skills/pdf" }
/// new fam.AgentSkill { source = "https://example.com/skills/review.zip" }
/// new fam.AgentSkill { source = "https://example.com/skills/review/SKILL.md" }
/// ```
///
/// FAM copies the skill to `~/.agents/skills/<name>`, marks it as managed, and links
/// `~/.claude/skills/<name>` to it. With `state = "absent"`, FAM removes the copy and the link,
/// but only when FAM made them. Skill tasks run as the SSH user: `sudo = true` is an error.
/// `restarts` restarts the units when the skill changes.
class AgentSkill extends StateTask {
  /// Where FAM gets the skill. The cockpit reads or downloads it once in each run.
  ///
  /// - A folder on the cockpit: a path relative to the bundle file, or an absolute path.
  /// - A public GitHub repository: `https://github.com/<owner>/<repo>`, with the folder in [path]
  ///   and the version in [ref]. A `/tree/<ref>/<folder>` URL sets both (the ref is one part).
  /// - A `.tar.gz`, `.tgz`, or `.zip` archive at an `https://` URL, with the folder in [path].
  ///   When all files of the archive are in one top folder, [path] is relative to that folder.
  /// - A `.md` file at an `https://` URL: a skill of one file. FAM saves it as `SKILL.md`.
  ///
  /// A bundle for every machine, a tag, or one machine selects its skills, so the skills can be
  /// different on each machine.
  source: String(!isEmpty && !startsWith("~"))

  /// The skill folder in a GitHub repository or an archive. The default is the top of the
  /// repository or the archive.
  path: String(!isEmpty && !startsWith("/") && !split("/").contains(".."))?

  /// For a GitHub repository: a tag, branch, or commit. When it is `null`, FAM uses the tag of
  /// the latest GitHub release, which is usually the latest version of the tool.
  ref: String?

  /// The skill name. The default is the last part of [path], or else the last part of [source]
  /// (without the archive or `.md` extension; for a `SKILL.md` file, its folder). A local folder
  /// named `skill` gets the name of the bundle.
  name: String(matches(Regex("[A-Za-z0-9][A-Za-z0-9._-]*")))?
}

/// A binary from a public GitHub release, installed into `~/.local/bin` without sudo.
/// FAM records each installed binary and its SHA-256. An existing binary without a record is a conflict.
/// FAM replaces a managed binary after a hand change and compares its version with the release tag.
/// Prefer static or musl builds for the plain Linux keys when available, because they run everywhere.
class GitHubRelease extends StateTask {
  /// The repository, `owner/name`.
  repo: String(matches(Regex("[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+")))

  /// The name of the installed binary.
  binary: String(matches(Regex("[A-Za-z0-9][A-Za-z0-9._-]*")))

  /// A command that prints the installed version. The default is `<binary> --version`.
  /// Its stdout or stderr must contain the version, with or without the leading `v`.
  /// FAM removes the tag prefix through the last `/` and accepts release or build suffixes.
  versionCommand: String?

  /// Assets by platform, for example `assets { ["linux-amd64"] { name = "tool.tar.gz"; file = "tool" } }`.
  /// On musl Linux, FAM uses the matching `-musl` key when present, else the plain Linux key.
  assets: Mapping<"linux-amd64"|"linux-arm64"|"linux-amd64-musl"|"linux-arm64-musl"|"darwin-arm64", ReleaseAsset>

  /// A pinned release tag. The default is the latest release.
  tag: String(!isEmpty)?
}

/// One release asset. FAM checks a SHA-256 checksum file when the release supplies one.
class ReleaseAsset {
  /// The asset name. `{tag}` expands to the full tag.
  /// `{version}` uses the part after the last `/`, without a leading `v`.
  name: String(!isEmpty && !contains("/") && !contains(".."))

  /// The asset format.
  format: "binary"|"tar.gz"|"tar.xz"|"tar.bz2"|"zip" = "binary"

  /// The binary path inside an archive. Required for `tar.gz`, `tar.xz`, `tar.bz2`, and `zip`.
  /// It also accepts `{tag}` and `{version}`.
  file: String(!isEmpty && !startsWith("/") && !split("/").contains(".."))?

  /// The checksum asset name. The default finds common SHA-256 checksum file names.
  checksum: String(!isEmpty && !contains("/"))?
}
