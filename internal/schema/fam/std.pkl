/// The standard bundles of FAM @FAM_VERSION@, in groups.
///
/// ```
/// import "@fam/std.pkl"
///
/// bundles { std.computer.agentBrowser; std.networking.portless }
/// ```
module fam.std

/// Tools that let agents use a computer: browsers and desktop apps.
computer = import("std/computer.pkl")

/// Tools that give agents context: source code of packages, a knowledge graph of a codebase, related issues.
context = import("std/context.pkl")

/// Tools that make media: video, images, and text.
media = import("std/media.pkl")

/// Tools for local networking.
networking = import("std/networking.pkl")

/// Tools for tests.
testing = import("std/testing.pkl")

/// Tools for the agents themselves.
agents = import("std/agents.pkl")

/// Programming languages for agents.
languages = import("std/languages.pkl")

/// Cloud platforms and their tools.
cloud = import("std/cloud.pkl")

/// Databases and data tools.
data = import("std/data.pkl")

/// Logs, metrics, and error reports.
observability = import("std/observability.pkl")

/// Tools for daily work.
work = import("std/work.pkl")

/// Git repositories and code review.
git = import("std/git.pkl")

/// Tools for security.
security = import("std/security.pkl")

/// AI services and tools.
ai = import("std/ai.pkl")

/// Tools for software development.
devtools = import("std/devtools.pkl")
