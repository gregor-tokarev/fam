/// Shared types of the FAM schema.
module fam.base

import "Bundle.pkl"
import "tasks.pkl" as t

/// The name of a machine tag, for example `"worker"` or `"gpu"`.
///
/// A machine can have many tags. `tags` in `config.pkl` gives bundles to the machines with a tag.
typealias Tag = String(matches(Regex("[A-Za-z0-9][A-Za-z0-9._-]*")))

/// The coding agents that FAM manages.
typealias AgentName = "claude"|"codex"|"antigravity"

/// A bundle with an explicit state.
///
/// Use it in a `bundles` listing when the state is not `"present"`:
///
/// ```
/// bundles {
///   new { bundle = import("bundles/posthog.pkl"); state = "absent" }
/// }
/// ```
class BundleRef {
  /// The bundle module.
  bundle: Bundle

  /// The wanted state of the bundle.
  state: t.State = "present"
}

/// The bundles of one tag.
class TagBundles {
  /// Bundles for every machine with this tag.
  ///
  /// Use `new { bundle = …; state = "absent" }` to remove a bundle of every machine from the
  /// machines with this tag.
  bundles: Listing<Bundle|BundleRef> = new Listing { default = (_) -> new BundleRef {} }
}

/// One machine of the fleet.
class Machine {
  /// The machine that runs FAM. FAM runs its commands locally, not over SSH.
  ///
  /// At most one machine can be the cockpit. All other machines are workers.
  cockpit: Boolean = false

  /// The tags of the machine, for example `tags { "worker"; "gpu" }`.
  ///
  /// The machine gets the bundles of each tag in `tags` of `config.pkl`, in the order of this list.
  /// A tag must be in `tags` of `config.pkl`, also when it has no bundles.
  tags: Listing<Tag>(isDistinct)

  /// The SSH host name or IP address of a worker.
  ///
  /// FAM connects to `user@address` with the system `ssh` command,
  /// so entries of `~/.ssh/config` apply.
  /// A worker must have an address. The cockpit has no address.
  address: String?(cockpit || this != null)

  /// The SSH user. When it is `null`, `ssh` selects the user.
  user: String?

  /// Bundles for this machine only.
  ///
  /// An entry here wins over the bundle with the same `name` in `bundles` or `tags` of `config.pkl`.
  /// Use `new { bundle = …; state = "absent" }` to remove such a bundle from this machine.
  bundles: Listing<Bundle|BundleRef> = new Listing { default = (_) -> new BundleRef {} }
}

/// The settings of one coding agent.
class Agent {
  /// Keys that FAM merges into the settings file of the agent.
  ///
  /// FAM keeps all other keys of the file.
  /// Claude Code: `~/.claude/settings.json`. Codex: `~/.codex/config.toml`.
  /// Antigravity CLI: `~/.gemini/antigravity-cli/settings.json`.
  settings: Dynamic

  /// A pinned CLI version, for example `"2.0.14"`.
  ///
  /// When it is `null`, FAM installs the latest version. `fam apply` updates the CLI when
  /// `<cli> --version` fails, and `fam apply --update` always updates it.
  ///
  /// The Antigravity CLI has no pinned versions: its installer gives only the latest version.
  version: String?
}

/// How FAM gives secrets to the machines.
///
/// The secrets come from one source: a file on the cockpit (`file`) or Infisical (`infisical`).
/// Set exactly one of them.
class Secrets {
  /// The delivery method. Version 0 supports only `"copy-file"`.
  ///
  /// FAM writes all secrets into one file on every machine over SSH, with mode `0600`,
  /// and exports every variable in new shells.
  delivery: "copy-file" = "copy-file"

  /// The secrets file on the cockpit, with one `NAME=value` line for each secret.
  ///
  /// The file must have mode `0600` and must not be inside the project base directory.
  /// Keep it `null` when the secrets come from [infisical].
  file: String?(
    if ((this == null) != (infisical == null)) true
    else throw("Set exactly one source of the secrets: `file` or `infisical`")
  )

  /// Read the secrets from Infisical instead of a file.
  ///
  /// ```
  /// secrets {
  ///   infisical {
  ///     projectId = "6f1c…"
  ///     environment = "prod"
  ///     credentials = "~/.config/fam-secrets/infisical.env"
  ///   }
  /// }
  /// ```
  infisical: Infisical?
}

/// A folder of an Infisical project as the source of the secrets.
///
/// FAM reads the secrets on the cockpit and keeps them in a cache with mode `0600`
/// (`<user cache dir>/fam/infisical`), so that runs inside [cache] do not call Infisical.
/// When Infisical cannot answer, FAM uses the last secrets that it read and shows a warning.
/// `fam check` never calls Infisical: it uses only the cache.
class Infisical {
  /// The Infisical site, without `/api`. For example `"https://eu.infisical.com"`
  /// or the address of a self-hosted Infisical. Plain `http://` is allowed only for localhost.
  /// FAM does not follow redirects.
  // No Pkl constraint: the error of a constraint shows the value, which can contain a password.
  // FAM checks the URL itself.
  siteUrl: String = "https://app.infisical.com"

  /// The ID of the Infisical project.
  projectId: String(!isEmpty)

  /// The slug of the environment, for example `"prod"`.
  environment: String(!isEmpty)

  /// The folder of the secrets.
  path: String(startsWith("/")) = "/"

  /// Also read the secrets in the subfolders of [path]. A name must occur in only one folder.
  recursive: Boolean = false

  /// Also read the secrets that the folder imports. A secret of the folder wins over an imported secret.
  includeImports: Boolean = true

  /// A file on the cockpit with the credentials of FAM, as `NAME=value` lines.
  ///
  /// A machine identity with Universal Auth: `INFISICAL_UNIVERSAL_AUTH_CLIENT_ID` and
  /// `INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET`. Or an access token: `INFISICAL_TOKEN`.
  /// The file must have mode `0600` and must not be inside the project base directory.
  /// When it is `null`, FAM reads these variables from the environment of `fam`.
  /// `fam check` also needs the credentials: they select the cache.
  credentials: String(!isBlank)?

  /// How long FAM uses the secrets that it read before it reads them again.
  /// `0.s` reads them on each run. `--refresh-secrets` ignores the cache for one run.
  cache: Duration(isPositive) = 5.min
}
