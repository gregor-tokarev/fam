//! Written by FAM @FAM_VERSION@. Do not edit. Run `fam upgrade` to update.

/// agent-browser: a browser automation CLI for AI agents (https://github.com/vercel-labs/agent-browser).
///
/// FAM installs the CLI with the global npm of the machine (Node.js 22 or later), and copies the
/// skill of its latest release from GitHub. To use another package manager, set it in
/// `config.pkl` (or for one machine):
///
/// ```
/// packageManagers { ["agent-browser"] = "vite" }
/// ```
///
/// FAM does not install a browser and does not change the system. Install the browser that
/// agent-browser uses yourself, for example with `agent-browser install`, or in a bundle of your own.
amends "../../Bundle.pkl"

import "../../Bundle.pkl"
import "../../tasks.pkl" as fam

name = "agent-browser"
description = "Browser automation CLI for AI agents"
version = "@FAM_VERSION@"
skill = new Bundle.GitHubSkill {
  repo = "vercel-labs/agent-browser"
  path = "skills/agent-browser"
}

instructions {
  "Use `agent-browser` for browser work. Run `agent-browser skills get core` before the first command."
}

tasks {
  // npm by default. Another manager: package = new { package = "agent-browser"; manager = "brew" }
  new fam.Package {
    package = "agent-browser"
  }
}

verify {
  new { name = "agent-browser --version"; event = "fresh_shell"; script = "agent-browser --version" }
}
