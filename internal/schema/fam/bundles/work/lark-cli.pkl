/// lark-cli: a CLI for Lark and Feishu collaboration services (https://github.com/larksuite/cli).
///
/// FAM installs @larksuite/cli with npm.
/// The CLI needs Node.js 16 or later.
/// Credentials: LARKSUITE_CLI_APP_SECRET, LARKSUITE_CLI_USER_ACCESS_TOKEN, LARKSUITE_CLI_TENANT_ACCESS_TOKEN.
/// FAM copies the core skills from the upstream repository.
/// Set LARKSUITE_CLI_APP_ID with an app secret, user token, or tenant token.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "lark-cli"
version = "@FAM_VERSION@"
requiredSecrets { "LARKSUITE_CLI_APP_SECRET"; "LARKSUITE_CLI_USER_ACCESS_TOKEN"; "LARKSUITE_CLI_TENANT_ACCESS_TOKEN" }
tasks {
  new fam.Package {
    package = "@larksuite/cli"
    binary = "lark-cli"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-approval"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-apps"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-attendance"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-base"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-calendar"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-contact"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-doc"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-drive"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-event"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-im"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-mail"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-markdown"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-meeting"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-note"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-okr"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-openapi-explorer"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-shared"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-sheets"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-skill-maker"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-slides"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-task"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-whiteboard"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-wiki"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-workflow-meeting-summary"
  }
  new fam.GitHubSkill {
    repo = "larksuite/cli"
    path = "skills/lark-workflow-standup-report"
  }
}

verify {
  new { name = "version"; script = "lark-cli --version" }
}
