/// ant: a CLI for the Claude Platform API (https://github.com/anthropics/anthropic-cli).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package github.com/anthropics/anthropic-cli/v2/cmd/ant.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
/// Credentials: ANTHROPIC_API_KEY.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "anthropics/tap/ant"
})

name = "ant"
version = "@FAM_VERSION@"
requiredSecrets { "ANTHROPIC_API_KEY" }
tasks {
  packages.retireRelease("ant", "anthropics/anthropic-cli")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/anthropics/anthropic-cli/v2/cmd/ant"; manager = "go" }
    binary = "ant"
  }
}

verify {
  new { name = "version"; script = "ant --version" }
}

uninstall { packages.retireRelease("ant", "anthropics/anthropic-cli") }
