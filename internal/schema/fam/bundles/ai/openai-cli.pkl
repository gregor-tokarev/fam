/// openai-cli: a CLI for OpenAI APIs and administration (https://github.com/openai/openai-cli).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package github.com/openai/openai-cli/cmd/openai.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
/// Credentials: OPENAI_API_KEY, OPENAI_ADMIN_KEY.
/// FAM copies the core skills from the upstream repository.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "openai/tools/openai"
})

name = "openai-cli"
description = "Call OpenAI APIs for responses, files, batches, images, audio, and administration"
version = "@FAM_VERSION@"
requiredSecrets { "OPENAI_API_KEY"; "OPENAI_ADMIN_KEY" }
tasks {
  packages.retireRelease("openai", "openai/openai-cli")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/openai/openai-cli/cmd/openai"; manager = "go" }
    binary = "openai"
  }
  new fam.GitHubSkill {
    repo = "openai/openai-cli"
    path = "skills/openai-cli"
  }
}

verify {
  new { name = "version"; script = "openai --version" }
}

uninstall { packages.retireRelease("openai", "openai/openai-cli") }
