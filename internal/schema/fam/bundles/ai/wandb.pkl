/// wandb: a CLI for Weights & Biases runs and artifacts (https://github.com/wandb/wandb).
///
/// FAM installs wandb with uv.
/// FAM needs uv and Python >=3.10.
/// Credentials: WANDB_API_KEY.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "wandb"
description = "Inspect and synchronize Weights & Biases runs, artifacts, and experiment data"
version = "@FAM_VERSION@"
requiredSecrets { "WANDB_API_KEY" }
tasks {
  new fam.Package {
    package = new fam.PackageRef {
      package = "wandb"
      manager = "uv"
    }
    binary = "wandb"
  }
}

verify {
  new { name = "version"; script = "wandb --version" }
}
