/// github: Manage GitHub repositories, issues, pull requests, releases, and workflows (https://github.com/cli/cli).
///
/// FAM uses the system package manager where this tool is packaged.
/// Use GH_TOKEN or GITHUB_TOKEN, or an existing login, for GitHub.
/// Enterprise hosts can use GH_ENTERPRISE_TOKEN or GITHUB_ENTERPRISE_TOKEN.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "github"
version = "@FAM_VERSION@"
requiredSecrets { "GH_TOKEN"; "GITHUB_TOKEN"; "GH_ENTERPRISE_TOKEN"; "GITHUB_ENTERPRISE_TOKEN" }
tasks {
  packages.retireRelease("gh", "cli/cli")
  new fam.Package {
    package = new fam.PackageRef {
      package = "gh"
      manager = "system"
      names {
        ["apt"] = "gh"
        ["dnf"] = "gh"
        ["pacman"] = "github-cli"
        ["apk"] = "github-cli"
        ["brew"] = "gh"
      }
    }
    binary = "gh"
  }
  new fam.GitHubSkill {
    repo = "cli/cli"
    path = "skills/gh"
  }
  new fam.GitHubSkill {
    repo = "cli/cli"
    path = "skills/gh-skill"
  }
}

verify {
  new { name = "version"; script = "gh --version" }
}

uninstall { packages.retireRelease("gh", "cli/cli") }
