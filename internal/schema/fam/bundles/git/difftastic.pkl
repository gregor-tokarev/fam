/// difftastic: Compare source files through syntax-aware diffs (https://github.com/Wilfred/difftastic).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official cargo package difftastic.
/// Git integration stays separate. Use explicit file paths without a terminal.
/// A current Rust toolchain and a C compiler must exist.
amends "../../Bundle.pkl"

import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "difftastic"
  ["pacman"] = "difftastic"
  ["apk"] = "difftastic"
  ["brew"] = "difftastic"
})

name = "difftastic"
description = "Compare source files through syntax-aware diffs"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("difft", "Wilfred/difftastic")
  packages.cargo("difftastic", "difft", systemPackage)
}

verify {
  new { name = "version"; script = "difft --version" }
}

uninstall { packages.retireRelease("difft", "Wilfred/difftastic") }
