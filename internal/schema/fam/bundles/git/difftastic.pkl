/// difftastic: Compare source files through syntax-aware diffs (https://github.com/Wilfred/difftastic).
///
/// FAM installs the binary from the latest GitHub release into ~/.local/bin.
/// The binary needs no runtime or compiler.
/// The vendor supplies no arm64 musl build. FAM skips that platform.
/// Git integration stays separate. Use explicit file paths without a terminal.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../../facts.pkl"

name = "difftastic"
version = "@FAM_VERSION@"
supported = !(facts.os == "linux" && facts.libc == "musl" && facts.arch == "arm64")
unsupportedReason = "The vendor supplies no arm64 musl build."
tasks {
  new fam.GitHubRelease {
    repo = "Wilfred/difftastic"
    binary = "difft"
    assets {
      ["linux-amd64"] { name = "difft-{version}-x86_64-unknown-linux-musl.tar.gz"; format = "tar.gz"; file = "difft" }
      ["linux-arm64"] { name = "difft-{version}-aarch64-unknown-linux-gnu.tar.gz"; format = "tar.gz"; file = "difft" }
      ["linux-amd64-musl"] { name = "difft-{version}-x86_64-unknown-linux-musl.tar.gz"; format = "tar.gz"; file = "difft" }
      ["darwin-arm64"] { name = "difft-{version}-aarch64-apple-darwin.tar.gz"; format = "tar.gz"; file = "difft" }
    }
  }
}

verify {
  new { name = "version"; script = "difft --version" }
}
