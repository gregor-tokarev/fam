/// delta: Display Git and diff output with syntax and line highlights (https://github.com/dandavison/delta).
///
/// FAM uses the system package manager where this tool is packaged.
/// The binary needs no runtime or compiler.
/// Git integration stays separate. Use --paging=never without a terminal.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages
import "../../facts.pkl"

name = "delta"
description = "Display Git and diff output with syntax and line highlights"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("delta", "dandavison/delta")
  new fam.Package {
    package = new fam.PackageRef {
      package = "git-delta"
      manager = "system"
      names {
        ["apt"] = "git-delta"
        ["dnf"] = "git-delta"
        ["pacman"] = "git-delta"
        ["apk"] = "delta"
        ["brew"] = "git-delta"
      }
    }
    binary = "delta"
  }
}

verify {
  new { name = "version"; script = "delta --version" }
}

uninstall { packages.retireRelease("delta", "dandavison/delta") }
