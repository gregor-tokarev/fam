/// git-lfs: Store and transfer large files through Git LFS (https://github.com/git-lfs/git-lfs).
///
/// FAM uses the system package manager where this tool is packaged.
/// Git must exist. Run git lfs install separately to configure Git filters and hooks.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "git-lfs"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("git-lfs", "git-lfs/git-lfs")
  new fam.Package {
    package = new fam.PackageRef {
      package = "git-lfs"
      manager = "system"
      names {
        ["apt"] = "git-lfs"
        ["dnf"] = "git-lfs"
        ["pacman"] = "git-lfs"
        ["apk"] = "git-lfs"
        ["brew"] = "git-lfs"
      }
    }
    binary = "git-lfs"
    versionCommand = #"fam_git_lfs_version=$(git-lfs version) && printf '%s\n' "${fam_git_lfs_version#git-lfs/}""#
  }
}

verify {
  new { name = "version"; script = "git-lfs version" }
}

uninstall { packages.retireRelease("git-lfs", "git-lfs/git-lfs") }
