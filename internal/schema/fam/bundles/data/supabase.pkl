/// supabase: Manage Supabase projects, migrations, functions, and local databases (https://github.com/supabase/cli).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official npm package. Node.js and npm must exist.
/// Cloud operations need SUPABASE_ACCESS_TOKEN or a login. Local stack commands need Docker.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "supabase"
})

name = "supabase"
version = "@FAM_VERSION@"
requiredSecrets { "SUPABASE_ACCESS_TOKEN" }
tasks {
  packages.retireRelease("supabase", "supabase/cli")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "supabase"; manager = "npm" }
    binary = "supabase"
  }
}

verify {
  new { name = "supabase --version"; script = "supabase --version" }
}

uninstall { packages.retireRelease("supabase", "supabase/cli") }
