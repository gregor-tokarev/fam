/// supabase: Manage Supabase projects, migrations, functions, and local databases (https://github.com/supabase/cli).
///
/// FAM installs the CLI from GitHub releases and checks the vendor SHA-256 file.
/// It needs no installer tools on the target. The npm package does not support global installation.
/// On musl Linux, Supabase also needs libstdc++ and libgcc.
/// FAM extracts only the CLI from the APK archive on musl, without a system package install.
/// Cloud operations need SUPABASE_ACCESS_TOKEN or a login. Local stack commands need Docker.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "supabase"
version = "@FAM_VERSION@"
requiredSecrets { "SUPABASE_ACCESS_TOKEN" }
tasks {
  new fam.GitHubRelease {
    repo = "supabase/cli"
    binary = "supabase"
    assets {
      ["linux-amd64"] { name = "supabase_{version}_linux_amd64.tar.gz"; format = "tar.gz"; file = "supabase"; checksum = "checksums.txt" }
      ["linux-arm64"] { name = "supabase_{version}_linux_arm64.tar.gz"; format = "tar.gz"; file = "supabase"; checksum = "checksums.txt" }
      ["linux-amd64-musl"] { name = "supabase_{version}_linux_amd64.apk"; format = "tar.gz"; file = "usr/bin/supabase"; checksum = "checksums.txt" }
      ["linux-arm64-musl"] { name = "supabase_{version}_linux_arm64.apk"; format = "tar.gz"; file = "usr/bin/supabase"; checksum = "checksums.txt" }
      ["darwin-arm64"] { name = "supabase_{version}_darwin_arm64.tar.gz"; format = "tar.gz"; file = "supabase"; checksum = "checksums.txt" }
    }
  }
}

verify {
  new { name = "supabase --version"; script = "supabase --version" }
}
