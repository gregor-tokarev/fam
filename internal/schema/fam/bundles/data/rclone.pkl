/// rclone: Copy and synchronize files across cloud storage services (https://github.com/rclone/rclone).
///
/// FAM uses the system package manager where this tool is packaged.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "rclone"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("rclone", "rclone/rclone")
  new fam.Package {
    package = new fam.PackageRef {
      package = "rclone"
      manager = "system"
      names {
        ["apt"] = "rclone"
        ["dnf"] = "rclone"
        ["pacman"] = "rclone"
        ["apk"] = "rclone"
        ["brew"] = "rclone"
      }
    }
    binary = "rclone"
    versionCommand = "rclone version"
  }
}

verify {
  new { name = "rclone version"; script = "rclone version" }
}

uninstall { packages.retireRelease("rclone", "rclone/rclone") }
