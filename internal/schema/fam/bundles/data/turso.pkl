/// turso: Manage Turso databases, branches, and access tokens (https://github.com/tursodatabase/turso-cli).
///
/// FAM installs the standalone CLI from GitHub and checks the vendor SHA-256 file.
/// The Linux release needs glibc. The vendor supplies no musl release.
/// Cloud operations need TURSO_API_TOKEN or a login.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../../facts.pkl"

name = "turso"
description = "Manage Turso databases, branches, and access tokens"
version = "@FAM_VERSION@"
supported = facts.libc != "musl"
unsupportedReason = "The vendor supplies no musl release."
requiredSecrets { "TURSO_API_TOKEN" }
tasks {
  new fam.GitHubRelease {
    repo = "tursodatabase/turso-cli"
    binary = "turso"
    versionCommand = "turso --version"
    assets {
      ["linux-amd64"] { name = "turso-cli_Linux_x86_64.tar.gz"; format = "tar.gz"; file = "turso"; checksum = "checksums.txt" }
      ["linux-arm64"] { name = "turso-cli_Linux_arm64.tar.gz"; format = "tar.gz"; file = "turso"; checksum = "checksums.txt" }
      ["darwin-arm64"] { name = "turso-cli_Darwin_arm64.tar.gz"; format = "tar.gz"; file = "turso"; checksum = "checksums.txt" }
    }
  }
}

verify {
  new { name = "turso --version"; script = "turso --version" }
}
