/// turso: Manage Turso databases, branches, and access tokens (https://github.com/tursodatabase/turso-cli).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package github.com/tursodatabase/turso-cli/cmd/turso.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
/// Cloud operations need TURSO_API_TOKEN or a login.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "tursodatabase/tap/turso"
})

name = "turso"
description = "Manage Turso databases, branches, and access tokens"
version = "@FAM_VERSION@"
requiredSecrets { "TURSO_API_TOKEN" }
tasks {
  packages.retireRelease("turso", "tursodatabase/turso-cli")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/tursodatabase/turso-cli/cmd/turso"; manager = "go" }
    binary = "turso"
    versionCommand = "turso --version"
  }
}

verify {
  new { name = "turso --version"; script = "turso --version" }
}

uninstall { packages.retireRelease("turso", "tursodatabase/turso-cli") }
