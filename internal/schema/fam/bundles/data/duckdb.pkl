/// duckdb: Query local files and analytical datasets with SQL (https://github.com/duckdb/duckdb).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other glibc systems use the official duckdb-cli package with uv. Python and uv must exist.
/// Musl systems use the release because PyPI supplies no musl wheel.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages
import "../../facts.pkl"

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "duckdb"
  ["brew"] = "duckdb"
})

local cliPackage = systemPackage ?? if (facts.os == "linux" && facts.libc == "musl") null
  else new fam.PackageRef { package = "duckdb-cli"; manager = "uv" }

name = "duckdb"
version = "@FAM_VERSION@"
tasks {
  when (cliPackage != null) {
    packages.retireRelease("duckdb", "duckdb/duckdb")
    new fam.Package {
      package = cliPackage!!
      binary = "duckdb"
      versionCommand = "duckdb --version"
    }
  } else {
    new fam.GitHubRelease {
      repo = "duckdb/duckdb"
      binary = "duckdb"
      versionCommand = "duckdb --version"
      assets {
        ["linux-amd64"] { name = "duckdb-cli-linux-amd64.tar.gz"; format = "tar.gz"; file = "duckdb" }
        ["darwin-arm64"] { name = "duckdb-cli-osx-arm64.tar.gz"; format = "tar.gz"; file = "duckdb" }
        ["linux-arm64"] { name = "duckdb-cli-linux-arm64.tar.gz"; format = "tar.gz"; file = "duckdb" }
        ["linux-amd64-musl"] { name = "duckdb-cli-linux-amd64-musl.tar.gz"; format = "tar.gz"; file = "duckdb" }
        ["linux-arm64-musl"] { name = "duckdb-cli-linux-arm64-musl.tar.gz"; format = "tar.gz"; file = "duckdb" }
      }
    }
  }
}

verify {
  new { name = "duckdb --version"; script = "duckdb --version" }
}

uninstall { packages.retireRelease("duckdb", "duckdb/duckdb") }
