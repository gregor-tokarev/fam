/// neonctl: Manage Neon PostgreSQL projects, branches, and database resources (https://github.com/neondatabase/neon-pkgs).
///
/// FAM installs the CLI with npm.
/// It needs Node.js 20.19 or later. Cloud operations need NEON_API_KEY or a login.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "neonctl"
description = "Manage Neon PostgreSQL projects, branches, and database resources"
version = "@FAM_VERSION@"
requiredSecrets { "NEON_API_KEY" }
tasks {
  new fam.Package {
    package = "neonctl"
    binary = "neonctl"
    versionCommand = "neonctl --version"
  }
}

verify {
  new { name = "neonctl --version"; script = "neonctl --version" }
}
