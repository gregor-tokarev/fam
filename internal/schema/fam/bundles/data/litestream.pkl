/// litestream: Replicate SQLite databases to external storage (https://github.com/benbjohnson/litestream).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official Go package github.com/benbjohnson/litestream/cmd/litestream.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
/// A C compiler supplies native database driver support.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "benbjohnson/litestream/litestream"
})

name = "litestream"
description = "Replicate SQLite databases to external storage"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("litestream", "benbjohnson/litestream")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/benbjohnson/litestream/cmd/litestream"; manager = "go" }
    binary = "litestream"
    versionCommand = "litestream version"
  }
}

verify {
  new { name = "litestream version"; script = "litestream version" }
}

uninstall { packages.retireRelease("litestream", "benbjohnson/litestream") }
