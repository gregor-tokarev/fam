/// litestream: Replicate SQLite databases to external storage (https://github.com/benbjohnson/litestream).
///
/// FAM installs the standalone CLI from the latest GitHub release.
/// Replication needs a configuration file. Storage credentials depend on the configured backend.
/// FAM does not start a replication service.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "litestream"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "benbjohnson/litestream"
    binary = "litestream"
    versionCommand = "litestream version"
    assets {
      ["linux-amd64"] { name = "litestream-{version}-linux-x86_64.tar.gz"; format = "tar.gz"; file = "litestream" }
      ["darwin-arm64"] { name = "litestream-{version}-darwin-arm64.tar.gz"; format = "tar.gz"; file = "litestream" }
      ["linux-arm64"] { name = "litestream-{version}-linux-arm64.tar.gz"; format = "tar.gz"; file = "litestream" }
    }
  }
}

verify {
  new { name = "litestream version"; script = "litestream version" }
}
