/// migrate: Run versioned database migrations (https://github.com/golang-migrate/migrate).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official release download.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "migrate"
  ["brew"] = "golang-migrate"
})

name = "migrate"
version = "@FAM_VERSION@"
tasks {
  when (systemPackage != null) {
    packages.retireRelease("migrate", "golang-migrate/migrate")
    new fam.Package {
      package = systemPackage!!
      binary = "migrate"
      versionCommand = "migrate -version 2>&1"
    }
  } else {
    new fam.GitHubRelease {
      repo = "golang-migrate/migrate"
      binary = "migrate"
      versionCommand = "migrate -version 2>&1"
      assets {
        ["linux-amd64"] { name = "migrate.linux-amd64.tar.gz"; format = "tar.gz"; file = "migrate" }
        ["darwin-arm64"] { name = "migrate.darwin-arm64.tar.gz"; format = "tar.gz"; file = "migrate" }
        ["linux-arm64"] { name = "migrate.linux-arm64.tar.gz"; format = "tar.gz"; file = "migrate" }
      }
    }
  }
}

verify {
  new { name = "migrate -version"; script = "migrate -version" }
}

uninstall { packages.retireRelease("migrate", "golang-migrate/migrate") }
