/// goose: Apply and track database schema migrations (https://github.com/pressly/goose).
///
/// FAM installs the standalone CLI from GitHub and checks the vendor SHA-256 file.
/// Database operations need GOOSE_DRIVER and a connection string in GOOSE_DBSTRING.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "goose"
version = "@FAM_VERSION@"
requiredSecrets { "GOOSE_DBSTRING" }
tasks {
  new fam.GitHubRelease {
    repo = "pressly/goose"
    binary = "goose"
    versionCommand = "goose --version"
    assets {
      ["linux-amd64"] { name = "goose_linux_x86_64"; checksum = "checksums.txt" }
      ["linux-arm64"] { name = "goose_linux_arm64"; checksum = "checksums.txt" }
      ["darwin-arm64"] { name = "goose_darwin_arm64"; checksum = "checksums.txt" }
    }
  }
}

verify {
  new { name = "goose --version"; script = "goose --version" }
}
