/// goose: Apply and track database schema migrations (https://github.com/pressly/goose).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package github.com/pressly/goose/v3/cmd/goose.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
/// A C compiler supplies native database driver support.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "goose"
})

name = "goose"
description = "Apply and track database schema migrations"
version = "@FAM_VERSION@"
requiredSecrets { "GOOSE_DBSTRING" }
tasks {
  packages.retireRelease("goose", "pressly/goose")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/pressly/goose/v3/cmd/goose"; manager = "go" }
    binary = "goose"
    versionCommand = "goose --version"
  }
}

verify {
  new { name = "goose --version"; script = "goose --version" }
}

uninstall { packages.retireRelease("goose", "pressly/goose") }
