/// usql: Query many database systems through a common CLI (https://github.com/xo/usql).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package github.com/xo/usql.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
/// A C compiler supplies native database driver support.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "xo/xo/usql"
})

name = "usql"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("usql", "xo/usql")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/xo/usql"; manager = "go" }
    binary = "usql"
  }
}

verify {
  new { name = "usql --version"; script = "usql --version" }
}

uninstall { packages.retireRelease("usql", "xo/usql") }
