/// usql: Query many database systems through a common CLI (https://github.com/xo/usql).
///
/// FAM downloads the latest release binary. Linux uses the static build, including on musl.
/// The vendor supplies no checksum file.
/// Some database drivers need native libraries. Connection credentials depend on the database.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "usql"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "xo/usql"
    binary = "usql"
    assets {
      ["linux-amd64"] { name = "usql_static-{version}-linux-amd64.tar.bz2"; format = "tar.bz2"; file = "usql_static" }
      ["linux-arm64"] { name = "usql_static-{version}-linux-arm64.tar.bz2"; format = "tar.bz2"; file = "usql_static" }
      ["darwin-arm64"] { name = "usql-{version}-darwin-arm64.tar.bz2"; format = "tar.bz2"; file = "usql" }
    }
  }
}

verify {
  new { name = "usql --version"; script = "usql --version" }
}
