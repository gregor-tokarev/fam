/// daytona: a CLI for Daytona sandboxes and remote commands (https://github.com/daytonaio/daytona).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official release download.
/// Credentials: DAYTONA_API_KEY.
/// Set DAYTONA_API_URL with DAYTONA_API_KEY for headless access.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages
import "../../facts.pkl"

local systemPackage = packages.system(new Mapping {
  ["brew"] = "daytonaio/cli/daytona"
})

name = "daytona"
version = "@FAM_VERSION@"
supported = systemPackage != null || (facts.libc != "musl")
unsupportedReason = "The Linux release requires glibc. Alpine is not supported."
requiredSecrets { "DAYTONA_API_KEY" }
tasks {
  when (systemPackage != null) {
    packages.retireRelease("daytona", "daytonaio/daytona")
    new fam.Package {
      package = systemPackage!!
      binary = "daytona"
      versionCommand = "daytona version"
    }
  } else {
    new fam.GitHubRelease {
      repo = "daytonaio/daytona"
      binary = "daytona"
      versionCommand = "daytona version"
      assets {
        ["linux-amd64"] { name = "daytona-linux-amd64" }
        ["linux-arm64"] { name = "daytona-linux-arm64" }
        ["darwin-arm64"] { name = "daytona-darwin-arm64" }
      }
    }
  }
}

verify {
  new { name = "version"; script = "daytona version" }
}

uninstall { packages.retireRelease("daytona", "daytonaio/daytona") }
