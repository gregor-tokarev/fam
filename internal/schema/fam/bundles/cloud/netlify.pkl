/// netlify: Deploy and manage Netlify sites (https://github.com/netlify/cli).
///
/// FAM installs the CLI with npm.
/// It needs Node.js 22.13 or later. Cloud operations need NETLIFY_AUTH_TOKEN or a login.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "netlify"
description = "Deploy and manage Netlify sites"
version = "@FAM_VERSION@"
requiredSecrets { "NETLIFY_AUTH_TOKEN" }
tasks {
  new fam.Package {
    package = "netlify-cli"
    binary = "netlify"
    versionCommand = "NO_UPDATE_NOTIFIER=1 netlify --version"
  }
}

verify {
  new { name = "NO_UPDATE_NOTIFIER=1 netlify --version"; script = "NO_UPDATE_NOTIFIER=1 netlify --version" }
}
