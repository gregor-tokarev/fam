/// doctl: Manage DigitalOcean compute, Kubernetes, and platform resources (https://github.com/digitalocean/doctl).
///
/// FAM installs the standalone CLI from GitHub and checks the vendor SHA-256 file.
/// Cloud operations need DIGITALOCEAN_ACCESS_TOKEN or a configured login.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "doctl"
description = "Manage DigitalOcean compute, Kubernetes, and platform resources"
version = "@FAM_VERSION@"
requiredSecrets { "DIGITALOCEAN_ACCESS_TOKEN" }
tasks {
  new fam.GitHubRelease {
    repo = "digitalocean/doctl"
    binary = "doctl"
    versionCommand = "doctl version | sed -n '1s/-release//p'"
    assets {
      ["linux-amd64"] { name = "doctl-{version}-linux-amd64.tar.gz"; format = "tar.gz"; file = "doctl"; checksum = "doctl-{version}-checksums.sha256" }
      ["linux-arm64"] { name = "doctl-{version}-linux-arm64.tar.gz"; format = "tar.gz"; file = "doctl"; checksum = "doctl-{version}-checksums.sha256" }
      ["darwin-arm64"] { name = "doctl-{version}-darwin-arm64.tar.gz"; format = "tar.gz"; file = "doctl"; checksum = "doctl-{version}-checksums.sha256" }
    }
  }
}

verify {
  new { name = "doctl version"; script = "doctl version" }
}
