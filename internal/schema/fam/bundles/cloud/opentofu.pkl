/// opentofu: Plan and apply infrastructure changes with OpenTofu (https://github.com/opentofu/opentofu).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official release download.
/// Provider credentials and external programs depend on the project. Use -input=false for automation.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "opentofu"
  ["pacman"] = "opentofu"
  ["apk"] = "opentofu"
  ["brew"] = "opentofu"
})

name = "opentofu"
description = "Plan and apply infrastructure changes with OpenTofu"
version = "@FAM_VERSION@"
tasks {
  when (systemPackage != null) {
    packages.retireRelease("tofu", "opentofu/opentofu")
    new fam.Package {
      package = systemPackage!!
      binary = "tofu"
      versionCommand = "tofu version"
    }
  } else {
    new fam.GitHubRelease {
      repo = "opentofu/opentofu"
      binary = "tofu"
      versionCommand = "tofu version"
      assets {
        ["linux-amd64"] { name = "tofu_{version}_linux_amd64.tar.gz"; format = "tar.gz"; file = "tofu" }
        ["darwin-arm64"] { name = "tofu_{version}_darwin_arm64.tar.gz"; format = "tar.gz"; file = "tofu" }
        ["linux-arm64"] { name = "tofu_{version}_linux_arm64.tar.gz"; format = "tar.gz"; file = "tofu" }
      }
    }
  }
}

verify {
  new { name = "tofu version"; script = "tofu version" }
}

uninstall { packages.retireRelease("tofu", "opentofu/opentofu") }
