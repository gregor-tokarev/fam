/// firebase: Deploy Firebase applications and manage project resources (https://github.com/firebase/firebase-tools).
///
/// FAM installs the CLI with npm.
/// It needs Node.js 20 or later. Use a service account file through GOOGLE_APPLICATION_CREDENTIALS.
/// FIREBASE_TOKEN is a deprecated alternative. Emulators can need Java or Docker.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "firebase"
description = "Deploy Firebase applications and manage project resources"
version = "@FAM_VERSION@"
requiredSecrets { "GOOGLE_APPLICATION_CREDENTIALS"; "FIREBASE_TOKEN" }
tasks {
  new fam.Package {
    package = "firebase-tools"
    binary = "firebase"
    versionCommand = "firebase --version"
  }
}

verify {
  new { name = "firebase --version"; script = "firebase --version" }
}
