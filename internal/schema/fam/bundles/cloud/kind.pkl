/// kind: Run local Kubernetes clusters in containers (https://github.com/kubernetes-sigs/kind).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package sigs.k8s.io/kind.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
/// Cluster operations need a separately installed Docker, Podman, or nerdctl engine.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "kind"
  ["pacman"] = "kind"
  ["apk"] = "kind"
  ["brew"] = "kind"
})

name = "kind"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("kind", "kubernetes-sigs/kind")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "sigs.k8s.io/kind"; manager = "go" }
    binary = "kind"
    versionCommand = "kind version"
  }
}

verify {
  new { name = "kind version"; script = "kind version" }
}

uninstall { packages.retireRelease("kind", "kubernetes-sigs/kind") }
