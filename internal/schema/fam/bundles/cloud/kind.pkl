/// kind: Run local Kubernetes clusters in containers (https://github.com/kubernetes-sigs/kind).
///
/// FAM installs the standalone CLI from GitHub and checks the vendor SHA-256 file.
/// Cluster operations need a separately installed Docker, Podman, or nerdctl engine.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "kind"
description = "Run local Kubernetes clusters in containers"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "kubernetes-sigs/kind"
    binary = "kind"
    versionCommand = "kind version"
    assets {
      ["linux-amd64"] { name = "kind-linux-amd64"; checksum = "kind-linux-amd64.sha256sum" }
      ["linux-arm64"] { name = "kind-linux-arm64"; checksum = "kind-linux-arm64.sha256sum" }
      ["darwin-arm64"] { name = "kind-darwin-arm64"; checksum = "kind-darwin-arm64.sha256sum" }
    }
  }
}

verify {
  new { name = "kind version"; script = "kind version" }
}
