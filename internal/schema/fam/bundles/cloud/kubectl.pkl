/// kubectl: Manage Kubernetes resources and clusters (https://github.com/kubernetes/kubernetes).
///
/// FAM downloads the latest official binary and checks the vendor SHA-256 file.
/// It installs only the CLI atomically into ~/.local/bin, without sudo.
/// Installation needs curl, standard shell tools, and sha256sum on Linux or shasum on macOS.
/// Cluster operations need a kubeconfig, cluster credentials, and a reachable cluster.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

local installKubectl = #"""
  set -eu
  mkdir -p "$HOME/.local/bin"
  work=$(mktemp -d "$HOME/.local/bin/.kubectl.XXXXXX")
  trap 'rm -rf "$work"' EXIT HUP INT TERM
  case "$(uname -s)" in
    Linux) os=linux ;;
    Darwin) os=darwin ;;
    *) echo 'Unsupported operating system' >&2; exit 1 ;;
  esac
  case "$(uname -m)" in
    x86_64) arch=amd64 ;;
    aarch64|arm64) arch=arm64 ;;
    *) echo 'Unsupported architecture' >&2; exit 1 ;;
  esac
  version=$(curl -fsSL https://dl.k8s.io/release/stable.txt)
  printf '%s\n' "$version" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'
  url="https://dl.k8s.io/release/$version/bin/$os/$arch/kubectl"
  curl -fsSL "$url" -o "$work/kubectl"
  expected=$(curl -fsSL "$url.sha256" | awk '{print $1}')
  case "$os" in
    darwin) actual=$(shasum -a 256 "$work/kubectl" | awk '{print $1}') ;;
    linux) actual=$(sha256sum "$work/kubectl" | awk '{print $1}') ;;
  esac
  [ "${#expected}" -eq 64 ] && [ "$actual" = "$expected" ] || { echo 'SHA-256 mismatch' >&2; exit 1; }
  chmod 755 "$work/kubectl"
  mv -f "$work/kubectl" "$HOME/.local/bin/kubectl"
  """#

name = "kubectl"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    binary = "~/.local/bin/kubectl"
    install = installKubectl
    update = installKubectl
    uninstall = "rm -f ~/.local/bin/kubectl"
    versionCommand = "kubectl version --client --output=yaml"
  }
}

verify {
  new { name = "kubectl version --client --output=yaml"; script = "kubectl version --client --output=yaml" }
}
