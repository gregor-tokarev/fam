/// podman: Control containers through a Podman service (https://github.com/podman-container-tools/podman).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official release download.
/// This bundle installs only the remote client. Container operations need a separately configured Podman service.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../../facts.pkl"
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["apt"] = "podman-remote"
  ["dnf"] = "podman-remote"
  ["apk"] = "podman-remote"
  ["brew"] = "podman"
})

name = "podman"
description = "Control containers through a Podman service"
version = "@FAM_VERSION@"
tasks {
  when (systemPackage != null) {
    packages.retireRelease("podman", "podman-container-tools/podman")
    new fam.Package {
      package = systemPackage!!
      binary = if (facts.os == "linux") "podman-remote" else "podman"
      versionCommand = "podman --version"
    }
  } else {
    new fam.GitHubRelease {
      repo = "podman-container-tools/podman"
      binary = "podman"
      versionCommand = "podman --version"
      assets {
        ["linux-amd64"] { name = "podman-remote-static-linux_amd64.tar.gz"; format = "tar.gz"; file = "bin/podman-remote-static-linux_amd64" }
        ["linux-arm64"] { name = "podman-remote-static-linux_arm64.tar.gz"; format = "tar.gz"; file = "bin/podman-remote-static-linux_arm64" }
        ["darwin-arm64"] { name = "podman-remote-release-darwin_arm64.zip"; format = "zip"; file = "podman-{version}/usr/bin/podman" }
      }
    }
  }
  when (facts.os == "linux" && systemPackage != null) {
    packages.releaseAlias("podman", "podman-container-tools/podman", "/usr/bin/podman-remote")
  }
}

verify {
  new { name = "podman --version"; script = "podman --version" }
}

uninstall {
  packages.retireRelease("podman", "podman-container-tools/podman")
  when (facts.os == "linux" && systemPackage != null) {
    new fam.Symlink { path = "~/.local/bin/podman"; target = "/usr/bin/podman-remote"; state = "absent" }
  }
}
