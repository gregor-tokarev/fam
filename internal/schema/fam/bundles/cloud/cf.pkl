/// cf: Official Cloudflare CLI for its complete API (https://github.com/cloudflare/cf).
///
/// FAM installs the CLI with npm.
/// It needs Node.js 22.23, 24.22, or 26.12 within the supported major version.
/// Use CLOUDFLARE_API_TOKEN or an interactive login. The CLI is a release candidate.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "cf"
description = "Official Cloudflare CLI for its complete API"
version = "@FAM_VERSION@"
requiredSecrets { "CLOUDFLARE_API_TOKEN" }
tasks {
  new fam.Package {
    package = "cf"
    binary = "cf"
    versionCommand = "cf --quiet --version"
  }
}

verify {
  new { name = "cf --quiet --version"; script = "cf --quiet --version" }
}
