/// crane: Inspect, copy, and modify container images in registries (https://github.com/google/go-containerregistry).
///
/// FAM installs the CLI with Go. Installation needs Go 1.25 or later.
/// Private registries need Docker credentials or crane auth login. It needs no container daemon.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "crane"
description = "Inspect, copy, and modify container images in registries"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = new fam.PackageRef { package = "github.com/google/go-containerregistry/cmd/crane"; manager = "go" }
    binary = "crane"
    versionCommand = "crane version"
  }
}

verify {
  new { name = "crane version"; script = "crane version" }
}
