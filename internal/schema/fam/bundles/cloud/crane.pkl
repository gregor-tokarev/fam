/// crane: Inspect, copy, and modify container images in registries (https://github.com/google/go-containerregistry).
///
/// FAM installs the standalone CLI from GitHub and checks the vendor SHA-256 file.
/// Private registries need Docker credentials or crane auth login. It needs no container daemon.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "crane"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "google/go-containerregistry"
    binary = "crane"
    versionCommand = "crane version"
    assets {
      ["linux-amd64"] { name = "go-containerregistry_Linux_x86_64.tar.gz"; format = "tar.gz"; file = "crane"; checksum = "checksums.txt" }
      ["linux-arm64"] { name = "go-containerregistry_Linux_arm64.tar.gz"; format = "tar.gz"; file = "crane"; checksum = "checksums.txt" }
      ["darwin-arm64"] { name = "go-containerregistry_Darwin_arm64.tar.gz"; format = "tar.gz"; file = "crane"; checksum = "checksums.txt" }
    }
  }
}

verify {
  new { name = "crane version"; script = "crane version" }
}
