/// flyctl: Deploy applications and manage Fly.io machines (https://github.com/superfly/flyctl).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official Go package github.com/superfly/flyctl.
/// Cloud operations need FLY_API_TOKEN or flyctl auth login.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "flyctl"
})

name = "flyctl"
version = "@FAM_VERSION@"
requiredSecrets { "FLY_API_TOKEN" }
tasks {
  packages.retireRelease("flyctl", "superfly/flyctl")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/superfly/flyctl"; manager = "go" }
    binary = "flyctl"
    versionCommand = "flyctl version"
  }
}

verify {
  new { name = "flyctl version"; script = "flyctl version" }
}

uninstall { packages.retireRelease("flyctl", "superfly/flyctl") }
