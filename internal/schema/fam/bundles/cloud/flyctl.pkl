/// flyctl: Deploy applications and manage Fly.io machines (https://github.com/superfly/flyctl).
///
/// FAM installs the standalone CLI from the latest GitHub release.
/// Cloud operations need FLY_API_TOKEN or flyctl auth login.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "flyctl"
description = "Deploy applications and manage Fly.io machines"
version = "@FAM_VERSION@"
requiredSecrets { "FLY_API_TOKEN" }
tasks {
  new fam.GitHubRelease {
    repo = "superfly/flyctl"
    binary = "flyctl"
    versionCommand = "flyctl version"
    assets {
      ["linux-amd64"] { name = "flyctl_{version}_Linux_x86_64.tar.gz"; format = "tar.gz"; file = "flyctl" }
      ["darwin-arm64"] { name = "flyctl_{version}_macOS_arm64.tar.gz"; format = "tar.gz"; file = "flyctl" }
      ["linux-arm64"] { name = "flyctl_{version}_Linux_arm64.tar.gz"; format = "tar.gz"; file = "flyctl" }
    }
  }
}

verify {
  new { name = "flyctl version"; script = "flyctl version" }
}
