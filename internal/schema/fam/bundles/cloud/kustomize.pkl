/// kustomize: Customize Kubernetes manifests without templates (https://github.com/kubernetes-sigs/kustomize).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official Go package sigs.k8s.io/kustomize/kustomize/v5.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "kustomize"
  ["pacman"] = "kustomize"
  ["apk"] = "kustomize"
  ["brew"] = "kustomize"
})

name = "kustomize"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("kustomize", "kubernetes-sigs/kustomize")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "sigs.k8s.io/kustomize/kustomize/v5"; manager = "go" }
    binary = "kustomize"
    versionCommand = "kustomize version"
  }
}

verify {
  new { name = "kustomize version"; script = "kustomize version" }
}

uninstall { packages.retireRelease("kustomize", "kubernetes-sigs/kustomize") }
