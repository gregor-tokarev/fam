/// kustomize: Customize Kubernetes manifests without templates (https://github.com/kubernetes-sigs/kustomize).
///
/// FAM installs the standalone CLI from GitHub and checks the vendor SHA-256 file.
/// Local manifest builds need no cluster or login.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "kustomize"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "kubernetes-sigs/kustomize"
    binary = "kustomize"
    versionCommand = "kustomize version"
    assets {
      ["linux-amd64"] { name = "kustomize_v{version}_linux_amd64.tar.gz"; format = "tar.gz"; file = "kustomize"; checksum = "checksums.txt" }
      ["linux-arm64"] { name = "kustomize_v{version}_linux_arm64.tar.gz"; format = "tar.gz"; file = "kustomize"; checksum = "checksums.txt" }
      ["darwin-arm64"] { name = "kustomize_v{version}_darwin_arm64.tar.gz"; format = "tar.gz"; file = "kustomize"; checksum = "checksums.txt" }
    }
  }
}

verify {
  new { name = "kustomize version"; script = "kustomize version" }
}
