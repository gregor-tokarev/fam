/// helm: Package and deploy applications on Kubernetes (https://github.com/helm/helm).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official Go package helm.sh/helm/v4/cmd/helm.
/// Cluster operations need a kubeconfig and cluster credentials.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "helm"
  ["pacman"] = "helm"
  ["apk"] = "helm"
  ["brew"] = "helm"
})

name = "helm"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "helm.sh/helm/v4/cmd/helm"; manager = "go" }
    binary = "helm"
    versionCommand = "helm version --short"
  }
}

verify {
  new { name = "helm version --short"; script = "helm version --short" }
}
