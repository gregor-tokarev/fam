/// trivy: Scan files, images, dependencies, secrets, and infrastructure configuration
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official Go package github.com/aquasecurity/trivy/cmd/trivy.
/// The binary needs no runtime or login for public scans. Vulnerability scans normally download databases.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "trivy"
  ["pacman"] = "trivy"
  ["brew"] = "trivy"
})

name = "trivy"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("trivy", "aquasecurity/trivy")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/aquasecurity/trivy/cmd/trivy"; manager = "go" }
    binary = "trivy"
  }
}

verify {
  new { name = "version"; script = "trivy --version" }
}

uninstall { packages.retireRelease("trivy", "aquasecurity/trivy") }
