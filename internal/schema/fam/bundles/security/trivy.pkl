/// trivy: Scan files, images, dependencies, secrets, and infrastructure configuration
/// (https://github.com/aquasecurity/trivy).
///
/// FAM installs the latest GitHub release into ~/.local/bin and checks its SHA-256.
/// The binary needs no runtime or login for public scans. Vulnerability scans normally download databases.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "trivy"
description = "Scan files, images, dependencies, secrets, and infrastructure configuration"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "aquasecurity/trivy"
    binary = "trivy"
    assets {
      ["linux-amd64"] { name = "trivy_{version}_Linux-64bit.tar.gz"; format = "tar.gz"; file = "trivy"; checksum = "trivy_{version}_checksums.txt" }
      ["linux-arm64"] { name = "trivy_{version}_Linux-ARM64.tar.gz"; format = "tar.gz"; file = "trivy"; checksum = "trivy_{version}_checksums.txt" }
      ["darwin-arm64"] { name = "trivy_{version}_macOS-ARM64.tar.gz"; format = "tar.gz"; file = "trivy"; checksum = "trivy_{version}_checksums.txt" }
    }
  }
}

verify {
  new { name = "version"; script = "trivy --version" }
}
