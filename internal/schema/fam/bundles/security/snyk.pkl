/// snyk: Scan dependencies, source code, containers, and infrastructure with Snyk (https://github.com/snyk/cli).
///
/// FAM installs the official snyk package with global npm.
/// Node.js 12 or later must exist. Scans need network access and SNYK_TOKEN.
/// The npm wrapper selects the vendor build for Alpine when needed.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "snyk"
version = "@FAM_VERSION@"
requiredSecrets { "SNYK_TOKEN" }
tasks {
  new fam.Package {
    package = "snyk"
    versionCommand = "SNYK_DISABLE_ANALYTICS=1 snyk --version"
  }
}

verify {
  new { name = "version"; script = "SNYK_DISABLE_ANALYTICS=1 snyk --version" }
}
