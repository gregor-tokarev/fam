/// osv-scanner: Find vulnerable dependencies in source trees, lockfiles, and container images (https://github.com/google/osv-scanner).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package github.com/google/osv-scanner/v2/cmd/osv-scanner.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "osv-scanner"
  ["apk"] = "osv-scanner"
  ["brew"] = "osv-scanner"
})

name = "osv-scanner"
description = "Find vulnerable dependencies in source trees, lockfiles, and container images"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("osv-scanner", "google/osv-scanner")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/google/osv-scanner/v2/cmd/osv-scanner"; manager = "go" }
    binary = "osv-scanner"
  }
}

verify {
  new { name = "version"; script = "osv-scanner --version" }
}

uninstall { packages.retireRelease("osv-scanner", "google/osv-scanner") }
