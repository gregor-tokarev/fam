/// osv-scanner: Find vulnerable dependencies in source trees, lockfiles, and container images (https://github.com/google/osv-scanner).
///
/// FAM installs the binary from the latest GitHub release into ~/.local/bin.
/// The binary needs no runtime or compiler.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "osv-scanner"
description = "Find vulnerable dependencies in source trees, lockfiles, and container images"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "google/osv-scanner"
    binary = "osv-scanner"
    assets {
      ["linux-amd64"] { name = "osv-scanner_linux_amd64"; checksum = "osv-scanner_SHA256SUMS" }
      ["linux-arm64"] { name = "osv-scanner_linux_arm64"; checksum = "osv-scanner_SHA256SUMS" }
      ["darwin-arm64"] { name = "osv-scanner_darwin_arm64"; checksum = "osv-scanner_SHA256SUMS" }
    }
  }
}

verify {
  new { name = "version"; script = "osv-scanner --version" }
}
