/// pact: Official CLI for API contract verification and mock servers (https://github.com/pact-foundation/pact-cli).
///
/// FAM uses npm package @pact-foundation/pact-cli.
/// Node.js and npm must exist.
/// Broker access can need separate credentials.
/// Pact has no top-level version flag. Its local stdout trace reports service.version.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "pact"
version = "@FAM_VERSION@"

tasks {
  packages.retireRelease("pact", "pact-foundation/pact-cli")
  new fam.Package {
    package = new fam.PackageRef { package = "@pact-foundation/pact-cli"; manager = "npm" }
    binary = "pact"
    versionCommand = #"""
      fam_pact_info=$(pact --log-level info --enable-otel-traces --otel-exporter stdout) &&
        printf '%s\n' "$fam_pact_info" | awk -F '"' '/service\.version=/ { print $2 }'
      """#
  }
}

verify {
  new { name = "pact runs"; script = "pact --help" }
}

uninstall { packages.retireRelease("pact", "pact-foundation/pact-cli") }
