/// pact: Official CLI for API contract verification and mock servers (https://github.com/pact-foundation/pact-cli).
///
/// FAM installs the CLI from the latest GitHub release and checks the archive's SHA-256.
/// Linux uses static musl binaries. No compiler, runtime, or login is required.
/// FAM extracts tar.xz itself. The machine does not need xz, curl, or tar for installation.
/// Broker access can need separate credentials.
/// Pact has no top-level version flag. Its local stdout trace reports service.version.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "pact"
version = "@FAM_VERSION@"

tasks {
  new fam.GitHubRelease {
    repo = "pact-foundation/pact-cli"
    binary = "pact"
    versionCommand = #"""
      fam_pact_info=$(pact --log-level info --enable-otel-traces --otel-exporter stdout) &&
        printf '%s\n' "$fam_pact_info" | awk -F '"' '/service\.version=/ { print $2 }'
      """#
    assets {
      ["linux-amd64"] { name = "pact-x86_64-unknown-linux-musl.tar.xz"; format = "tar.xz"; file = "pact-x86_64-unknown-linux-musl/pact"; checksum = "sha256.sum" }
      ["linux-arm64"] { name = "pact-aarch64-unknown-linux-musl.tar.xz"; format = "tar.xz"; file = "pact-aarch64-unknown-linux-musl/pact"; checksum = "sha256.sum" }
      ["linux-amd64-musl"] { name = "pact-x86_64-unknown-linux-musl.tar.xz"; format = "tar.xz"; file = "pact-x86_64-unknown-linux-musl/pact"; checksum = "sha256.sum" }
      ["linux-arm64-musl"] { name = "pact-aarch64-unknown-linux-musl.tar.xz"; format = "tar.xz"; file = "pact-aarch64-unknown-linux-musl/pact"; checksum = "sha256.sum" }
      ["darwin-arm64"] { name = "pact-aarch64-apple-darwin.tar.xz"; format = "tar.xz"; file = "pact-aarch64-apple-darwin/pact"; checksum = "sha256.sum" }
    }
  }
}

verify {
  new { name = "pact runs"; script = "pact --help" }
}
