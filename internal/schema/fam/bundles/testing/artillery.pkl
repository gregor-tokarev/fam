/// artillery: Load testing CLI for HTTP, WebSocket, and browser workloads (https://github.com/artilleryio/artillery).
///
/// FAM installs the CLI with global npm.
/// Needs Node.js 22.18 or later. Local HTTP tests need no account.
/// Browser tests need a separate browser. PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD prevents browser installation.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "artillery"
description = "Load testing CLI for HTTP, WebSocket, and browser workloads"
version = "@FAM_VERSION@"
env { ["PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"] = "1" }
tasks {
  new fam.Package {
    package = "artillery"
    binary = "artillery"
  }
}

verify {
  new { name = "artillery runs"; script = "artillery --version" }
}
