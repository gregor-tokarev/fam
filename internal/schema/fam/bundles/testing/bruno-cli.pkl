/// bruno-cli: Official Bruno CLI for API collections and test reports (https://github.com/usebruno/bruno).
///
/// FAM installs the CLI with global npm.
/// Needs Node.js. Local API collections need no login.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "bruno-cli"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = "@usebruno/cli"
    binary = "bru"
    versionCommand = "bru --help"
  }
}

verify {
  new { name = "bru runs"; script = "bru --help" }
}
