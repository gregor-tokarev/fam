/// emulate: local emulation of APIs for CI and sandboxes without network (https://github.com/vercel-labs/emulate).
///
/// FAM installs the CLI with the global npm of the machine, and copies the skill of its latest
/// release from GitHub. For another package manager, use `withManager`, for example `withManager("vite")`.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "emulate"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = "emulate"
  }
  new fam.AgentSkill {
    source = "https://github.com/vercel-labs/emulate"
    path = "skills/emulate"
  }
}

verify {
  new { name = "emulate --version"; script = "emulate --version" }
}
