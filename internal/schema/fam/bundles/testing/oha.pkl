/// oha: HTTP load generator with JSON output and a noninteractive mode (https://github.com/hatoo/oha).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Cargo package oha.
/// A current Rust toolchain and a C compiler must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "oha"
  ["brew"] = "oha"
})

name = "oha"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("oha", "hatoo/oha")
  packages.cargo("oha", "oha", systemPackage)
}

verify {
  new { name = "oha runs"; script = "oha --version" }
}

uninstall { packages.retireRelease("oha", "hatoo/oha") }
