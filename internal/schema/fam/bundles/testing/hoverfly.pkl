/// hoverfly: HTTP service simulation and API mock proxy CLI (https://github.com/SpectoLabs/hoverfly).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official Go package github.com/SpectoLabs/hoverfly/core/cmd/hoverfly.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "hoverfly"
})

name = "hoverfly"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("hoverfly", "SpectoLabs/hoverfly")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/SpectoLabs/hoverfly/core/cmd/hoverfly"; manager = "go" }
    binary = "hoverfly"
    versionCommand = "hoverfly -version"
  }
}

verify {
  new { name = "hoverfly runs"; script = "hoverfly -version" }
}

uninstall { packages.retireRelease("hoverfly", "SpectoLabs/hoverfly") }
