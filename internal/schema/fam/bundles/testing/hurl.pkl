/// hurl: Run HTTP requests and API checks from plain text files (https://github.com/Orange-OpenSource/hurl).
///
/// FAM uses the system package on Arch and macOS. Other systems build the official Cargo package.
/// A current Rust toolchain and a C compiler must exist. FAM installs the native build dependencies.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "hurl"
  ["brew"] = "hurl"
})

name = "hurl"
version = "@FAM_VERSION@"
tasks {
  when (systemPackage == null) {
    new fam.Package {
      package = new fam.PackageRef {
        package = "libcurl4-openssl-dev"
        manager = "system"
        names { ["dnf"] = "libcurl-devel"; ["apk"] = "curl-dev" }
      }
    }
    new fam.Package {
      package = new fam.PackageRef {
        package = "libxml2-dev"
        manager = "system"
        names { ["dnf"] = "libxml2-devel" }
      }
    }
    new fam.Package {
      package = new fam.PackageRef {
        package = "libclang-dev"
        manager = "system"
        names { ["dnf"] = "clang-devel"; ["apk"] = "clang-dev" }
      }
    }
  }
  packages.retireRelease("hurl", "Orange-OpenSource/hurl")
  packages.cargo("hurl", "hurl", systemPackage)
}

verify {
  new { name = "hurl runs"; script = "hurl --version" }
}

uninstall { packages.retireRelease("hurl", "Orange-OpenSource/hurl") }
