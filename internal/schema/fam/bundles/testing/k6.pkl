/// k6: Scriptable HTTP and browser load testing CLI from Grafana (https://github.com/grafana/k6).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official Go package go.k6.io/k6/v2.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "k6"
})

name = "k6"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("k6", "grafana/k6")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "go.k6.io/k6/v2"; manager = "go" }
    binary = "k6"
    versionCommand = "k6 version"
  }
}

verify {
  new { name = "k6 runs"; script = "k6 version" }
}

uninstall { packages.retireRelease("k6", "grafana/k6") }
