/// mockoon-cli: Official Mockoon CLI for headless API mock servers (https://github.com/mockoon/mockoon).
///
/// FAM installs the CLI with global npm.
/// Needs Node.js 18 or later. Local mock servers need no account.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "mockoon-cli"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = "@mockoon/cli"
    binary = "mockoon-cli"
  }
}

verify {
  new { name = "mockoon-cli runs"; script = "mockoon-cli --version" }
}
