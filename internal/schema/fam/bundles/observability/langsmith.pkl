/// langsmith: a CLI for LangSmith traces, runs, and evaluations (https://github.com/langchain-ai/langsmith-cli).
///
/// FAM uses the system package where available. Other systems build the official Go package.
/// Go must exist. PyPI publishing is not available yet.
/// Credentials: LANGSMITH_API_KEY.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "langchain-ai/tap/langsmith-cli"
})

name = "langsmith"
version = "@FAM_VERSION@"
requiredSecrets { "LANGSMITH_API_KEY" }
tasks {
  packages.retireRelease("langsmith", "langchain-ai/langsmith-cli")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/langchain-ai/langsmith-cli/cmd/langsmith"; manager = "go" }
    binary = "langsmith"
  }
}

verify {
  new { name = "version"; script = "langsmith --version" }
}

uninstall { packages.retireRelease("langsmith", "langchain-ai/langsmith-cli") }
