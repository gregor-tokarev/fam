/// newrelic: a CLI for New Relic data and resources (https://github.com/newrelic/newrelic-cli).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official release download.
/// Credentials: NEW_RELIC_API_KEY.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "newrelic-cli"
})

name = "newrelic"
description = "Query New Relic data and manage observability resources"
version = "@FAM_VERSION@"
requiredSecrets { "NEW_RELIC_API_KEY" }
tasks {
  when (systemPackage != null) {
    packages.retireRelease("newrelic", "newrelic/newrelic-cli")
    new fam.Package {
      package = systemPackage!!
      binary = "newrelic"
      versionCommand = "newrelic version"
    }
  } else {
    new fam.GitHubRelease {
      repo = "newrelic/newrelic-cli"
      binary = "newrelic"
      versionCommand = "newrelic version"
      assets {
        ["linux-amd64"] { name = "newrelic-cli_{version}_Linux_x86_64.tar.gz"; checksum = "newrelic-cli_{version}_checksums.txt"; format = "tar.gz"; file = "newrelic" }
        ["linux-arm64"] { name = "newrelic-cli_{version}_Linux_arm64.tar.gz"; checksum = "newrelic-cli_{version}_checksums.txt"; format = "tar.gz"; file = "newrelic" }
        ["darwin-arm64"] { name = "newrelic-cli_{version}_Darwin_arm64.tar.gz"; checksum = "newrelic-cli_{version}_checksums.txt"; format = "tar.gz"; file = "newrelic" }
      }
    }
  }
}

verify {
  new { name = "version"; script = "newrelic version" }
}

uninstall { packages.retireRelease("newrelic", "newrelic/newrelic-cli") }
