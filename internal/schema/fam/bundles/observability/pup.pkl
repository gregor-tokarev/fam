/// pup: a CLI for Datadog logs, traces, monitors, and services (https://github.com/DataDog/pup).
///
/// FAM installs @datadog/pup with npm.
/// The CLI needs Node.js 18 or later.
/// Credentials: DD_API_KEY, DD_APP_KEY, DD_ACCESS_TOKEN.
/// FAM copies the core skills from the upstream repository.
/// Use DD_API_KEY with DD_APP_KEY, or use DD_ACCESS_TOKEN.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "pup"
version = "@FAM_VERSION@"
requiredSecrets { "DD_API_KEY"; "DD_APP_KEY"; "DD_ACCESS_TOKEN" }
tasks {
  new fam.Package {
    package = "@datadog/pup"
    binary = "pup"
  }
  new fam.GitHubSkill {
    repo = "DataDog/pup"
    path = "skills/dd-apm"
  }
  new fam.GitHubSkill {
    repo = "DataDog/pup"
    path = "skills/dd-debugger"
  }
  new fam.GitHubSkill {
    repo = "DataDog/pup"
    path = "skills/dd-docs"
  }
  new fam.GitHubSkill {
    repo = "DataDog/pup"
    path = "skills/dd-idp"
  }
  new fam.GitHubSkill {
    repo = "DataDog/pup"
    path = "skills/dd-logs"
  }
  new fam.GitHubSkill {
    repo = "DataDog/pup"
    path = "skills/dd-monitors"
  }
  new fam.GitHubSkill {
    repo = "DataDog/pup"
    path = "skills/dd-pup"
  }
  new fam.GitHubSkill {
    repo = "DataDog/pup"
    path = "skills/dd-symdb"
  }
  new fam.GitHubSkill {
    repo = "DataDog/pup"
    path = "skills/dd-triage-flaky-test"
  }
  new fam.GitHubSkill {
    repo = "DataDog/pup"
    path = "skills/dd-unblock-pr"
  }
}

verify {
  new { name = "version"; script = "pup --version" }
}
