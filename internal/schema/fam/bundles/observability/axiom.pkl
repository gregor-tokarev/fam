/// axiom: a CLI for Axiom datasets, logs, and traces (https://github.com/axiomhq/cli).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package github.com/axiomhq/cli/cmd/axiom.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
/// Credentials: AXIOM_TOKEN.
/// FAM copies the core skills from the upstream repository.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "axiomhq/tap/axiom"
})

name = "axiom"
description = "Query Axiom datasets, logs, and traces from the command line"
version = "@FAM_VERSION@"
requiredSecrets { "AXIOM_TOKEN" }
tasks {
  packages.retireRelease("axiom", "axiomhq/cli")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/axiomhq/cli/cmd/axiom"; manager = "go" }
    binary = "axiom"
  }
  new fam.GitHubSkill {
    repo = "axiomhq/cli"
    path = "skills/axiom-apl"
  }
  new fam.GitHubSkill {
    repo = "axiomhq/cli"
    path = "skills/detect-anomalies"
  }
  new fam.GitHubSkill {
    repo = "axiomhq/cli"
    path = "skills/explore-dataset"
  }
  new fam.GitHubSkill {
    repo = "axiomhq/cli"
    path = "skills/find-traces"
  }
}

verify {
  new { name = "version"; script = "axiom --version" }
}

uninstall { packages.retireRelease("axiom", "axiomhq/cli") }
