/// cx: a CLI for Coralogix telemetry and resources (https://github.com/coralogix/cx-cli).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Cargo package coralogix-cli.
/// A current Rust toolchain and a C compiler must exist. FAM builds the CLI into ~/.local/bin.
/// FAM declares the D-Bus development package for source builds.
/// Credentials: CX_API_KEY.
/// FAM copies the core skills from the upstream repository.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "cx"
})

name = "cx"
version = "@FAM_VERSION@"
requiredSecrets { "CX_API_KEY" }
tasks {
  packages.retireRelease("cx", "coralogix/cx-cli")
  when (systemPackage == null) {
    new fam.Package {
      package = new fam.PackageRef {
        package = "libdbus-1-dev"
        manager = "system"
        names { ["dnf"] = "dbus-devel"; ["pacman"] = "dbus"; ["apk"] = "dbus-dev" }
      }
    }
  }
  packages.cargo("coralogix-cli", "cx", systemPackage)
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/coralogix-docs"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-ai-center"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-alerts"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-cases"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-cli"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-cost-optimization"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-dashboards"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-data-pipeline"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-infra"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-observability-setup"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-olly"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-platform-admin"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-profiling"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-rum-setup"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-search-dashboard"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-service-catalog"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-slos"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-telemetry-querying"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-coding-agents"
  }
}

verify {
  new { name = "version"; script = "cx --version" }
}

uninstall { packages.retireRelease("cx", "coralogix/cx-cli") }
