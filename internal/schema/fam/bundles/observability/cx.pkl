/// cx: a CLI for Coralogix telemetry and resources (https://github.com/coralogix/cx-cli).
///
/// FAM installs coralogix-cli with cargo.
/// The build needs Cargo and Rust.
/// On Linux, it also needs pkg-config and the OpenSSL and D-Bus development files.
/// Credentials: CX_API_KEY.
/// FAM copies the core skills from the upstream repository.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "cx"
description = "Query Coralogix telemetry and manage observability resources"
version = "@FAM_VERSION@"
requiredSecrets { "CX_API_KEY" }
tasks {
  new fam.Package {
    package = new fam.PackageRef {
      package = "coralogix-cli"
      manager = "cargo"
    }
    binary = "cx"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/coralogix-docs"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-ai-center"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-alerts"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-cases"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-cli"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-cost-optimization"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-dashboards"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-data-pipeline"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-infra"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-observability-setup"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-olly"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-platform-admin"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-profiling"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-rum-setup"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-search-dashboard"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-service-catalog"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-slos"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-telemetry-querying"
  }
  new fam.GitHubSkill {
    repo = "coralogix/cx-cli"
    path = "skills/cx-coding-agents"
  }
}

verify {
  new { name = "version"; script = "cx --version" }
}
