/// honeymarker: a CLI for Honeycomb deployment markers (https://github.com/honeycombio/honeymarker).
///
/// FAM uses go package github.com/honeycombio/honeymarker.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
/// Credentials: HONEYCOMB_API_KEY.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "honeymarker"
version = "@FAM_VERSION@"
requiredSecrets { "HONEYCOMB_API_KEY" }
tasks {
  packages.retireRelease("honeymarker", "honeycombio/honeymarker")
  new fam.Package {
    package = new fam.PackageRef { package = "github.com/honeycombio/honeymarker"; manager = "go" }
    binary = "honeymarker"
    versionCommand = "honeymarker version"
  }
}

verify {
  new { name = "version"; script = "honeymarker version" }
}

uninstall { packages.retireRelease("honeymarker", "honeycombio/honeymarker") }
