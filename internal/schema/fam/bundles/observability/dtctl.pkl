/// dtctl: a CLI for Dynatrace telemetry and resources (https://github.com/Dynatrace/dtctl).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official release download.
/// Credentials: DT_API_TOKEN.
/// FAM copies the core skills from the upstream repository.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "dynatrace-oss/tap/dtctl"
})

name = "dtctl"
version = "@FAM_VERSION@"
requiredSecrets { "DT_API_TOKEN" }
tasks {
  when (systemPackage != null) {
    packages.retireRelease("dtctl", "Dynatrace/dtctl")
    new fam.Package {
      package = systemPackage!!
      binary = "dtctl"
      versionCommand = "dtctl version"
    }
  } else {
    new fam.GitHubRelease {
      repo = "Dynatrace/dtctl"
      binary = "dtctl"
      versionCommand = "dtctl version"
      assets {
        ["linux-amd64"] { name = "dtctl_{version}_linux_amd64.tar.gz"; format = "tar.gz"; file = "dtctl" }
        ["linux-arm64"] { name = "dtctl_{version}_linux_arm64.tar.gz"; format = "tar.gz"; file = "dtctl" }
        ["darwin-arm64"] { name = "dtctl_{version}_darwin_arm64.tar.gz"; format = "tar.gz"; file = "dtctl" }
      }
    }
  }
  new fam.GitHubSkill {
    repo = "Dynatrace/dtctl"
    path = "skills/dtctl"
  }
}

verify {
  new { name = "version"; script = "dtctl version" }
}

uninstall { packages.retireRelease("dtctl", "Dynatrace/dtctl") }
