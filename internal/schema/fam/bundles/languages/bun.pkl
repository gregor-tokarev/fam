/// bun: Run JavaScript and TypeScript with the Bun toolchain (https://github.com/oven-sh/bun).
///
/// FAM uses the system package where available. Other systems use npm package bun.
/// Node.js and npm must exist.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "bun"
  ["brew"] = "bun"
})

name = "bun"
description = "Run JavaScript and TypeScript with the Bun toolchain"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("bun", "oven-sh/bun")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "bun"; manager = "npm" }
    binary = "bun"
    versionCommand = #"v=$(bun --version) && printf 'bun-v%s\n' "$v""#
  }
}

verify {
  new { name = "version"; script = "bun --version" }
}

uninstall { packages.retireRelease("bun", "oven-sh/bun") }
