/// go: Build and format Go programs with the Go toolchain (https://github.com/golang/go).
///
/// FAM uses the system package manager where this tool is packaged.
/// Homebrew provides Go on macOS. Linux uses the distribution package, including gofmt.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

local legacyOwnership = #"""
  set -eu
  root="$HOME/.local/share/fam/go"
  target=$(readlink "$HOME/.local/bin/go" 2>/dev/null || true)
  case "$target" in
    "$root"/*/toolchain/bin/go) ;;
    *) exit 0 ;;
  esac
  fmt=$(readlink "$HOME/.local/bin/gofmt" 2>/dev/null || true)
  if [ -e "$HOME/.local/bin/gofmt" ] || [ -L "$HOME/.local/bin/gofmt" ]; then
    if [ "$fmt" != "${target%/go}/gofmt" ]; then
      echo 'The previous FAM gofmt link changed. Preserve or remove it before apply.' >&2
      exit 1
    fi
  fi
  """#
local retireLegacy = new fam.Script {
  name = "Replace the previous FAM Go toolchain"
  check = legacyOwnership + "\nexit 100"
  apply = legacyOwnership + "\n" + #"rm -f -- "$HOME/.local/bin/go" "$HOME/.local/bin/gofmt" && rm -rf -- "$HOME/.local/share/fam/go""#
}

name = "go"
version = "@FAM_VERSION@"
tasks {
  retireLegacy
  new fam.Package {
    package = new fam.PackageRef {
      package = "go"
      manager = "system"
      names {
        ["apt"] = "golang-go"
        ["dnf"] = "golang"
        ["pacman"] = "go"
        ["apk"] = "go"
        ["brew"] = "go"
      }
    }
    binary = "go"
    versionCommand = "go version"
  }
}

verify {
  new { name = "version"; script = #"go version && printf 'package main\n' | gofmt"# }
}

uninstall { retireLegacy }
