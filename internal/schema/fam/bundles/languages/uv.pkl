/// uv: Manage Python interpreters, packages, environments, and command-line tools (https://github.com/astral-sh/uv).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms build the official Cargo package. A current Rust toolchain and C compiler must exist.
amends "../../Bundle.pkl"

import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "uv"
  ["pacman"] = "uv"
  ["apk"] = "uv"
  ["brew"] = "uv"
})

name = "uv"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("uv", "astral-sh/uv")
  packages.cargo("uv", "uv", systemPackage)
}

verify {
  new { name = "version"; script = "uv --version" }
}

uninstall { packages.retireRelease("uv", "astral-sh/uv") }
