/// deno: Run JavaScript and TypeScript with the Deno toolchain (https://github.com/denoland/deno).
///
/// FAM uses the system package where available. Other systems use npm package deno.
/// Node.js and npm must exist.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages
import "../../facts.pkl"

supported = systemPackage != null || !(facts.os == "linux" && facts.libc == "musl")
unsupportedReason = "The vendor supplies no musl build."

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "deno"
  ["apk"] = "deno"
  ["brew"] = "deno"
})

name = "deno"
description = "Run JavaScript and TypeScript with the Deno toolchain"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("deno", "denoland/deno")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "deno"; manager = "npm" }
    binary = "deno"
  }
}

verify {
  new { name = "version"; script = "deno --version" }
}

uninstall { packages.retireRelease("deno", "denoland/deno") }
