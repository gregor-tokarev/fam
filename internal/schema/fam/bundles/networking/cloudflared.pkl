/// cloudflared: Expose local services through Cloudflare Tunnel (https://github.com/cloudflare/cloudflared).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the official release download.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "cloudflared"
  ["brew"] = "cloudflared"
})

name = "cloudflared"
version = "@FAM_VERSION@"
requiredSecrets { "TUNNEL_TOKEN" }
tasks {
  when (systemPackage != null) {
    packages.retireRelease("cloudflared", "cloudflare/cloudflared")
    new fam.Package {
      package = systemPackage!!
      binary = "cloudflared"
      versionCommand = "cloudflared --version"
    }
  } else {
    new fam.GitHubRelease {
      repo = "cloudflare/cloudflared"
      binary = "cloudflared"
      versionCommand = "cloudflared --version"
      assets {
        ["linux-amd64"] { name = "cloudflared-linux-amd64"; format = "binary" }
        ["darwin-arm64"] { name = "cloudflared-darwin-arm64.tgz"; format = "tar.gz"; file = "cloudflared" }
        ["linux-arm64"] { name = "cloudflared-linux-arm64"; format = "binary" }
      }
    }
  }
}

verify {
  new { name = "cloudflared --version"; script = "cloudflared --version" }
}

uninstall { packages.retireRelease("cloudflared", "cloudflare/cloudflared") }
