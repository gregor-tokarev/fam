/// tailscale: Connect machines through the Tailscale private network (https://github.com/tailscale/tailscale).
///
/// FAM uses the system package on Arch, Alpine, and macOS. Other systems build the CLI with Go.
/// Network operations need a separately configured tailscaled daemon and login.
/// This bundle does not configure the network or start a daemon.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "tailscale"
  ["apk"] = "tailscale"
  ["brew"] = "tailscale"
})

name = "tailscale"
description = "Connect worker machines through the Tailscale private network"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "tailscale.com/cmd/tailscale"; manager = "go" }
    binary = "tailscale"
    versionCommand = "tailscale version"
  }
}

verify {
  new { name = "tailscale version"; script = "tailscale version" }
}
