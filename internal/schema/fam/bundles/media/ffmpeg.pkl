/// ffmpeg: Official command line tools for video, audio, and media conversion (https://github.com/FFmpeg/FFmpeg).
///
/// FAM installs the CLI with the system package manager.
/// Needs the system package manager. No runtime or login is required.
/// Fedora uses ffmpeg-free, which omits some codecs.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "ffmpeg"
description = "Official command line tools for video, audio, and media conversion"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = new fam.PackageRef {
      package = "ffmpeg"
      manager = "system"
      names { ["dnf"] = "ffmpeg-free" }
    }
    binary = "ffmpeg"
    versionCommand = "ffmpeg -version"
  }
}

verify {
  new { name = "ffmpeg runs"; script = "ffmpeg -version" }
}
