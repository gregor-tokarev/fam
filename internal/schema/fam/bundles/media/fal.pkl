/// fal: Official fal CLI for model API calls, generation queues, and deployments (https://github.com/fal-ai/fal).
///
/// FAM installs the CLI with uv tool install.
/// Needs uv, Python 3.10 or later, and FAL_KEY for API calls.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "fal"
version = "@FAM_VERSION@"
requiredSecrets { "FAL_KEY" }
tasks {
  new fam.Package {
    package = new fam.PackageRef {
      package = "fal"
      manager = "uv"
    }
    binary = "fal"
    versionCommand = "fam_fal_version=$(fal --version) && printf '%s\\n' \"$fam_fal_version\""
  }
}

verify {
  new { name = "fal runs"; script = "fam_fal_version=$(fal --version) && printf '%s\\n' \"$fam_fal_version\"" }
}
