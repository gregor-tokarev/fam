/// resvg: Official standalone SVG renderer CLI with PNG output (https://github.com/linebender/resvg).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Cargo package resvg.
/// A current Rust toolchain and a C compiler must exist. FAM builds the CLI into ~/.local/bin.
/// No display or login is required. Install fonts separately for text output.
amends "../../Bundle.pkl"

import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "resvg"
  ["brew"] = "resvg"
})

name = "resvg"
description = "Official standalone SVG renderer CLI with PNG output"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("resvg", "linebender/resvg")
  packages.cargo("resvg", "resvg", systemPackage)
}

verify {
  new { name = "resvg runs"; script = "resvg --version" }
}

uninstall { packages.retireRelease("resvg", "linebender/resvg") }
