/// vips: Official image processing CLI for large images and batch operations (https://github.com/libvips/libvips).
///
/// FAM installs the CLI with the system package manager.
/// Needs the system package manager. No display or login is required.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "vips"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = new fam.PackageRef {
      package = "vips"
      manager = "system"
      names { ["apt"] = "libvips-tools"; ["dnf"] = "vips-tools"; ["apk"] = "vips-tools"; ["pacman"] = "libvips" }
    }
    binary = "vips"
  }
}

verify {
  new { name = "vips runs"; script = "vips --version" }
}
