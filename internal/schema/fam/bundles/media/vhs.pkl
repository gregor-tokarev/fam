/// vhs: Scripted terminal recording CLI that creates videos and GIFs (https://github.com/charmbracelet/vhs).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package github.com/charmbracelet/vhs.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
/// Recording needs separate FFmpeg, ttyd, and a headless browser.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "vhs"
  ["pacman"] = "vhs"
  ["apk"] = "vhs"
  ["brew"] = "vhs"
})

name = "vhs"
description = "Scripted terminal recording CLI that creates videos and GIFs"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("vhs", "charmbracelet/vhs")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/charmbracelet/vhs"; manager = "go" }
    binary = "vhs"
  }
}

verify {
  new { name = "vhs runs"; script = "vhs --version" }
}

uninstall { packages.retireRelease("vhs", "charmbracelet/vhs") }
