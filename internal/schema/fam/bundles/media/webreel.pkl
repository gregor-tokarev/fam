/// webreel: records scripted browser demos as video (https://github.com/vercel-labs/webreel).
///
/// FAM installs the CLI with the global npm of the machine, and copies the skill of its latest
/// release from GitHub. For another package manager, use `withManager`, for example `withManager("vite")`.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "webreel"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = "webreel"
  }
  new fam.AgentSkill {
    source = "https://github.com/vercel-labs/webreel"
    path = "skills/webreel"
  }
}

verify {
  new { name = "webreel --version"; script = "webreel --version" }
}
