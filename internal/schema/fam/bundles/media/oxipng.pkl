/// oxipng: Lossless PNG optimization CLI with parallel processing (https://github.com/oxipng/oxipng).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Cargo package oxipng.
/// A current Rust toolchain and a C compiler must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "oxipng"
  ["pacman"] = "oxipng"
  ["apk"] = "oxipng"
  ["brew"] = "oxipng"
})

name = "oxipng"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("oxipng", "oxipng/oxipng")
  packages.cargo("oxipng", "oxipng", systemPackage)
}

verify {
  new { name = "oxipng runs"; script = "oxipng --version" }
}

uninstall { packages.retireRelease("oxipng", "oxipng/oxipng") }
