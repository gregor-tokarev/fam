/// HyperFrames: agents write HTML, HyperFrames renders it to video (https://github.com/heygen-com/hyperframes).
///
/// FAM installs the CLI with the global npm of the machine, and copies the skill of its latest
/// release from GitHub. To use another package manager, set `packageManagers` in `config.pkl`.
/// The skills are the core set of HyperFrames. The CLI needs Node.js 22 or later, FFmpeg, and Chrome to
/// render. FAM does not install them: `hyperframes doctor` shows what is missing.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "hyperframes"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = "hyperframes"
  }
  new fam.GitHubSkill {
    repo = "heygen-com/hyperframes"
    path = "skills/hyperframes"
  }
  new fam.GitHubSkill {
    repo = "heygen-com/hyperframes"
    path = "skills/hyperframes-cli"
  }
  new fam.GitHubSkill {
    repo = "heygen-com/hyperframes"
    path = "skills/hyperframes-registry"
  }
  new fam.GitHubSkill {
    repo = "heygen-com/hyperframes"
    path = "skills/media-use"
  }
  new fam.GitHubSkill {
    repo = "heygen-com/hyperframes"
    path = "skills/reverse-any-video"
  }
  new fam.GitHubSkill {
    repo = "heygen-com/hyperframes"
    path = "skills/style-sampling"
  }
}

verify {
  new { name = "hyperframes --version"; script = "hyperframes --version" }
}
