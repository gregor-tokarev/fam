/// agg: Official renderer that converts asciinema recordings to GIF files (https://github.com/asciinema/agg).
///
/// FAM installs the CLI with a GitHub release.
/// No runtime or login is required. Linux arm64 has no musl build.
/// The crates.io package named agg is an unrelated tool.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../../facts.pkl"

name = "agg"
description = "Official renderer that converts asciinema recordings to GIF files"
version = "@FAM_VERSION@"
supported = facts.os != "linux" || facts.libc != "musl" || facts.arch != "arm64"
tasks {
  new fam.GitHubRelease {
    repo = "asciinema/agg"
    binary = "agg"
    assets {
      ["linux-amd64"] { name = "agg-x86_64-unknown-linux-musl" }
      ["linux-arm64"] { name = "agg-aarch64-unknown-linux-gnu" }
      ["linux-amd64-musl"] { name = "agg-x86_64-unknown-linux-musl" }
      ["darwin-arm64"] { name = "agg-aarch64-apple-darwin" }
    }
  }
}

verify {
  new { name = "agg runs"; script = "agg --version" }
}
