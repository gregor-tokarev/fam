/// asciinema: Terminal recording CLI with a headless mode for scripts and CI (https://github.com/asciinema/asciinema).
///
/// FAM uses the system package manager where this tool is packaged.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages
import "../../facts.pkl"

name = "asciinema"
description = "Terminal recording CLI with a headless mode for scripts and CI"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("asciinema", "asciinema/asciinema")
  new fam.Package {
    package = new fam.PackageRef {
      package = "asciinema"
      manager = "system"
      names {
        ["apt"] = "asciinema"
        ["dnf"] = "asciinema"
        ["pacman"] = "asciinema"
        ["apk"] = "asciinema"
        ["brew"] = "asciinema"
      }
    }
    binary = "asciinema"
  }
}

verify {
  new { name = "asciinema runs"; script = "asciinema --version" }
}

uninstall { packages.retireRelease("asciinema", "asciinema/asciinema") }
