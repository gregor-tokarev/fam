/// direnv: Load project environment variables through explicit shell or exec integration (https://github.com/direnv/direnv).
///
/// FAM uses the system package manager where this tool is packaged.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "direnv"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("direnv", "direnv/direnv")
  new fam.Package {
    package = new fam.PackageRef {
      package = "direnv"
      manager = "system"
      names {
        ["apt"] = "direnv"
        ["dnf"] = "direnv"
        ["pacman"] = "direnv"
        ["apk"] = "direnv"
        ["brew"] = "direnv"
      }
    }
    binary = "direnv"
    versionCommand = "direnv version"
  }
}

verify {
  new { name = "version"; script = "direnv version" }
}

uninstall { packages.retireRelease("direnv", "direnv/direnv") }
