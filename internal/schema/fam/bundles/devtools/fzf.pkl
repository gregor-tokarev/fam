/// fzf: Filter and rank text candidates through fuzzy matching (https://github.com/junegunn/fzf).
///
/// FAM uses the system package manager where this tool is packaged.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "fzf"
description = "Filter and rank text candidates through fuzzy matching"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("fzf", "junegunn/fzf")
  new fam.Package {
    package = new fam.PackageRef {
      package = "fzf"
      manager = "system"
      names {
        ["apt"] = "fzf"
        ["dnf"] = "fzf"
        ["pacman"] = "fzf"
        ["apk"] = "fzf"
        ["brew"] = "fzf"
      }
    }
    binary = "fzf"
  }
}

verify {
  new { name = "version"; script = "fzf --version" }
}

uninstall { packages.retireRelease("fzf", "junegunn/fzf") }
