/// nx: Inspect monorepos, generate projects, and execute dependency-aware build tasks (https://github.com/nrwl/nx).
///
/// FAM installs the official nx package with global npm.
/// Node.js must exist.
/// Nx Cloud and MCP integrations need separate configuration. FAM copies the seven public workspace skills.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "nx"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = "nx"
  }
  new fam.GitHubSkill {
    repo = "nrwl/nx"
    path = ".github/skills/link-workspace-packages"
  }
  new fam.GitHubSkill {
    repo = "nrwl/nx"
    path = ".github/skills/monitor-ci"
  }
  new fam.GitHubSkill {
    repo = "nrwl/nx"
    path = ".github/skills/nx-generate"
  }
  new fam.GitHubSkill {
    repo = "nrwl/nx"
    path = ".github/skills/nx-import"
  }
  new fam.GitHubSkill {
    repo = "nrwl/nx"
    path = ".github/skills/nx-plugins"
  }
  new fam.GitHubSkill {
    repo = "nrwl/nx"
    path = ".github/skills/nx-run-tasks"
  }
  new fam.GitHubSkill {
    repo = "nrwl/nx"
    path = ".github/skills/nx-workspace"
  }
}

verify {
  new { name = "version"; script = "nx --version" }
}
