/// pitchfork: Start, inspect, and stop project services with readiness and dependency checks (https://github.com/jdx/pitchfork).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Cargo package pitchfork-cli.
/// A current Rust toolchain and a C compiler must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["brew"] = "pitchfork"
})

name = "pitchfork"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("pitchfork", "jdx/pitchfork")
  packages.cargo("pitchfork-cli", "pitchfork", systemPackage)
  new fam.GitHubSkill {
    repo = "jdx/pitchfork"
    path = "skills/pitchfork"
  }
}

verify {
  new { name = "version"; script = "pitchfork --version" }
}

uninstall { packages.retireRelease("pitchfork", "jdx/pitchfork") }
