/// yq: Read and transform YAML, JSON, XML, and other structured data (https://github.com/mikefarah/yq).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package github.com/mikefarah/yq/v4.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "yq"
  ["pacman"] = "go-yq"
  ["apk"] = "yq-go"
  ["brew"] = "yq"
})

name = "yq"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("yq", "mikefarah/yq")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/mikefarah/yq/v4"; manager = "go" }
    binary = "yq"
  }
}

verify {
  new { name = "version"; script = "yq --version" }
}

uninstall { packages.retireRelease("yq", "mikefarah/yq") }
