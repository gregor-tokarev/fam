/// yq: Read and transform YAML, JSON, XML, and other structured data (https://github.com/mikefarah/yq).
///
/// FAM installs the binary from the latest GitHub release into ~/.local/bin.
/// The binary needs no runtime or compiler.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "yq"
description = "Read and transform YAML, JSON, XML, and other structured data"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "mikefarah/yq"
    binary = "yq"
    assets {
      ["linux-amd64"] { name = "yq_linux_amd64"; checksum = "checksums-bsd" }
      ["linux-arm64"] { name = "yq_linux_arm64"; checksum = "checksums-bsd" }
      ["darwin-arm64"] { name = "yq_darwin_arm64"; checksum = "checksums-bsd" }
    }
  }
}

verify {
  new { name = "version"; script = "yq --version" }
}
