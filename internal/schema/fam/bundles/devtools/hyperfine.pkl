/// hyperfine: Benchmark shell commands and export machine-readable timing results (https://github.com/sharkdp/hyperfine).
///
/// FAM uses the system package manager where this tool is packaged.
/// The binary needs no runtime or compiler.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "hyperfine"
description = "Benchmark shell commands and export machine-readable timing results"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("hyperfine", "sharkdp/hyperfine")
  new fam.Package {
    package = new fam.PackageRef {
      package = "hyperfine"
      manager = "system"
      names {
        ["apt"] = "hyperfine"
        ["dnf"] = "hyperfine"
        ["pacman"] = "hyperfine"
        ["apk"] = "hyperfine"
        ["brew"] = "hyperfine"
      }
    }
    binary = "hyperfine"
  }
}

verify {
  new { name = "version"; script = "hyperfine --version" }
}

uninstall { packages.retireRelease("hyperfine", "sharkdp/hyperfine") }
