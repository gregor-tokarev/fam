/// glow: Render Markdown files and standard input in a terminal (https://github.com/charmbracelet/glow).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package charm.land/glow/v3.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["dnf"] = "glow"
  ["pacman"] = "glow"
  ["brew"] = "glow"
})

name = "glow"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("glow", "charmbracelet/glow")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "charm.land/glow/v3"; manager = "go" }
    binary = "glow"
  }
}

verify {
  new { name = "version"; script = "glow --version" }
}

uninstall { packages.retireRelease("glow", "charmbracelet/glow") }
