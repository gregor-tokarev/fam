/// glow: Render Markdown files and standard input in a terminal (https://github.com/charmbracelet/glow).
///
/// FAM builds the official Go module with Go into ~/.local/bin.
/// Go 1.26.5 or later must exist.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "glow"
description = "Render Markdown files and standard input in a terminal"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = new fam.PackageRef {
      package = "charm.land/glow/v3"
      manager = "go"
    }
    install = #"GOTOOLCHAIN=local GOBIN="$HOME/.local/bin" go install charm.land/glow/v3@latest"#
    update = #"GOTOOLCHAIN=local GOBIN="$HOME/.local/bin" go install charm.land/glow/v3@latest"#
    binary = "glow"
  }
}

verify {
  new { name = "version"; script = "glow --version" }
}
