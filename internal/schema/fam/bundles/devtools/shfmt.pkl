/// shfmt: Format shell scripts and validate their syntax (https://github.com/mvdan/sh).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package mvdan.cc/sh/v3/cmd/shfmt.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["apt"] = "shfmt"
  ["pacman"] = "shfmt"
  ["apk"] = "shfmt"
  ["brew"] = "shfmt"
})

name = "shfmt"
description = "Format shell scripts and validate their syntax"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("shfmt", "mvdan/sh")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "mvdan.cc/sh/v3/cmd/shfmt"; manager = "go" }
    binary = "shfmt"
  }
}

verify {
  new { name = "version"; script = "shfmt --version" }
}

uninstall { packages.retireRelease("shfmt", "mvdan/sh") }
