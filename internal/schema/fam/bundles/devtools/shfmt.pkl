/// shfmt: Format shell scripts and validate their syntax (https://github.com/mvdan/sh).
///
/// FAM installs the binary from the latest GitHub release into ~/.local/bin.
/// The binary needs no runtime or compiler.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "shfmt"
description = "Format shell scripts and validate their syntax"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "mvdan/sh"
    binary = "shfmt"
    assets {
      ["linux-amd64"] { name = "shfmt_{tag}_linux_amd64" }
      ["linux-arm64"] { name = "shfmt_{tag}_linux_arm64" }
      ["darwin-arm64"] { name = "shfmt_{tag}_darwin_arm64" }
    }
  }
}

verify {
  new { name = "version"; script = "shfmt --version" }
}
