/// usage: Validate CLI specifications and generate command help, documentation, and completions (https://github.com/jdx/usage).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Cargo package usage-cli.
/// A current Rust toolchain and a C compiler must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "usage"
  ["brew"] = "usage"
})

name = "usage"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("usage", "jdx/usage")
  packages.cargo("usage-cli", "usage", systemPackage)
  new fam.AgentSkill {
    source = "https://github.com/jdx/usage"
    path = "skills/usage"
  }
}

verify {
  new { name = "version"; script = "usage --version" }
}

uninstall { packages.retireRelease("usage", "jdx/usage") }
