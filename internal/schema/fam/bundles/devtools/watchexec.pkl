/// watchexec: Run commands after files change, with debounce and process control (https://github.com/watchexec/watchexec).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Cargo package watchexec-cli.
/// A current Rust toolchain and a C compiler must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["pacman"] = "watchexec"
  ["apk"] = "watchexec"
  ["brew"] = "watchexec"
})

name = "watchexec"
description = "Run commands after files change, with debounce and process control"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("watchexec", "watchexec/watchexec")
  packages.cargo("watchexec-cli", "watchexec", systemPackage)
}

verify {
  new { name = "version"; script = "watchexec --version" }
}

uninstall { packages.retireRelease("watchexec", "watchexec/watchexec") }
