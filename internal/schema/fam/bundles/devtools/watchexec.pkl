/// watchexec: Run commands after files change, with debounce and process control (https://github.com/watchexec/watchexec).
///
/// FAM installs the latest GitHub release and checks its SHA-256.
/// FAM extracts tar.xz itself. Linux uses static musl builds. No compiler is necessary.
/// Watched commands need their own shell or interpreter.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "watchexec"
description = "Run commands after files change, with debounce and process control"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "watchexec/watchexec"
    binary = "watchexec"
    assets {
      ["linux-amd64"] { name = "watchexec-{version}-x86_64-unknown-linux-musl.tar.xz"; format = "tar.xz"; file = "watchexec-{version}-x86_64-unknown-linux-musl/watchexec"; checksum = "SHA256SUMS" }
      ["linux-arm64"] { name = "watchexec-{version}-aarch64-unknown-linux-musl.tar.xz"; format = "tar.xz"; file = "watchexec-{version}-aarch64-unknown-linux-musl/watchexec"; checksum = "SHA256SUMS" }
      ["darwin-arm64"] { name = "watchexec-{version}-aarch64-apple-darwin.tar.xz"; format = "tar.xz"; file = "watchexec-{version}-aarch64-apple-darwin/watchexec"; checksum = "SHA256SUMS" }
    }
  }
}

verify {
  new { name = "version"; script = "watchexec --version" }
}
