/// jq: Read, transform, and query JSON in shell workflows (https://github.com/jqlang/jq).
///
/// FAM uses the system package manager where this tool is packaged.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "jq"
description = "Read, transform, and query JSON in shell workflows"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("jq", "jqlang/jq")
  new fam.Package {
    package = new fam.PackageRef {
      package = "jq"
      manager = "system"
      names {
        ["apt"] = "jq"
        ["dnf"] = "jq"
        ["pacman"] = "jq"
        ["apk"] = "jq"
        ["brew"] = "jq"
      }
    }
    binary = "jq"
  }
}

verify {
  new { name = "version"; script = "jq --version" }
}

uninstall { packages.retireRelease("jq", "jqlang/jq") }
