/// jq: Read, transform, and query JSON in shell workflows (https://github.com/jqlang/jq).
///
/// FAM installs the binary from the latest GitHub release into ~/.local/bin.
/// The binary needs no runtime or login.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "jq"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "jqlang/jq"
    binary = "jq"
    assets {
      ["linux-amd64"] { name = "jq-linux-amd64" }
      ["linux-arm64"] { name = "jq-linux-arm64" }
      ["darwin-arm64"] { name = "jq-macos-arm64" }
    }
  }
}

verify {
  new { name = "version"; script = "jq --version" }
}
