/// mise: Manage developer tools, project environments, and task execution (https://github.com/jdx/mise).
///
/// FAM installs the official mise package with global npm on glibc Linux and macOS.
/// On musl Linux, FAM runs the official installer for its static binary.
/// That binary exceeds the 128 MiB limit of a FAM GitHubRelease task.
/// The npm installation needs Node.js.
/// FAM installs only mise. Each project selects and installs its own runtimes.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../../facts.pkl"

name = "mise"
description = "Manage developer tools, project environments, and task execution"
version = "@FAM_VERSION@"
tasks {
  when (facts.os == "linux" && facts.libc == "musl") {
    new fam.Package {
      binary = "~/.local/bin/mise"
      install = #"curl -fsSL https://mise.run | MISE_INSTALL_MUSL=1 MISE_INSTALL_EXT=tar.gz MISE_INSTALL_PATH="$HOME/.local/bin/mise" MISE_INSTALL_HELP=0 sh"#
      update = #"curl -fsSL https://mise.run | MISE_INSTALL_MUSL=1 MISE_INSTALL_EXT=tar.gz MISE_INSTALL_PATH="$HOME/.local/bin/mise" MISE_INSTALL_HELP=0 sh"#
      uninstall = "rm -f ~/.local/bin/mise"
      versionCommand = "mise --version"
    }
  } else {
    new fam.Package {
      package = "mise"
    }
  }
}

verify {
  new { name = "version"; script = "mise --version" }
}
