/// mise: Manage developer tools, project environments, and tasks (https://github.com/jdx/mise).
///
/// FAM uses the system package on Arch, Alpine, and macOS. Other systems use the official npm package.
/// The npm package needs Node.js. Each project selects and installs its own runtimes.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "mise"
version = "@FAM_VERSION@"
local systemPackage = packages.system(new Mapping {
  ["pacman"] = "mise"
  ["apk"] = "mise"
  ["brew"] = "mise"
})

tasks {
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "mise"; manager = "npm" }
    binary = "mise"
  }
}

verify {
  new { name = "version"; script = "mise --version" }
}
