/// just: Run project commands and recipes from a justfile (https://github.com/casey/just).
///
/// FAM uses the system package manager where this tool is packaged.
/// The binary needs no runtime or compiler.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "just"
description = "Run project commands and recipes from a justfile"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("just", "casey/just")
  new fam.Package {
    package = new fam.PackageRef {
      package = "just"
      manager = "system"
      names {
        ["apt"] = "just"
        ["dnf"] = "just"
        ["pacman"] = "just"
        ["apk"] = "just"
        ["brew"] = "just"
      }
    }
    binary = "just"
  }
  new fam.GitHubSkill {
    repo = "casey/just"
    path = "skills/just"
  }
}

verify {
  new { name = "version"; script = "just --version" }
}

uninstall { packages.retireRelease("just", "casey/just") }
