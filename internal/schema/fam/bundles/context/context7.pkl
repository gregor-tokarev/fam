/// context7: a CLI for current library documentation (https://github.com/upstash/context7).
///
/// FAM installs ctx7 with npm.
/// The CLI needs Node.js >=22.13.0.
/// Credentials: CONTEXT7_API_KEY.
/// FAM copies the core skills from the upstream repository.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "context7"
version = "@FAM_VERSION@"
requiredSecrets { "CONTEXT7_API_KEY" }
tasks {
  new fam.Package {
    package = "ctx7"
    binary = "ctx7"
  }
  new fam.AgentSkill {
    source = "https://github.com/upstash/context7"
    path = "skills/context7-cli"
  }
  new fam.AgentSkill {
    source = "https://github.com/upstash/context7"
    path = "skills/find-docs"
  }
}

verify {
  new { name = "version"; script = "ctx7 --version" }
}
