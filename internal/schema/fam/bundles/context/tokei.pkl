/// tokei: Count source lines, comments, and language totals (https://github.com/XAMPPRocky/tokei).
///
/// FAM uses the system package where available. Older Ubuntu releases build the Cargo package.
/// The Cargo package needs a current Rust toolchain and a C compiler.
amends "../../Bundle.pkl"

import "../../facts.pkl"
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  when (facts.distro != "ubuntu" || facts.distroVersion.split(".")[0].toInt() >= 26) {
    ["apt"] = "tokei"
  }
  ["dnf"] = "tokei"
  ["pacman"] = "tokei"
  ["apk"] = "tokei"
  ["brew"] = "tokei"
})

name = "tokei"
version = "@FAM_VERSION@"
tasks {
  packages.cargo("tokei", "tokei", systemPackage)
}

verify {
  new { name = "version"; script = "tokei --version" }
}
