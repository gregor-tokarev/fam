/// tokei: a code counter with language totals (https://github.com/XAMPPRocky/tokei).
///
/// FAM installs tokei with cargo.
/// The build needs Cargo, Rust, and a C linker.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "tokei"
description = "Count source lines, comments, and language totals across a repository"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = new fam.PackageRef {
      package = "tokei"
      manager = "cargo"
    }
    binary = "tokei"
  }
}

verify {
  new { name = "version"; script = "tokei --version" }
}
