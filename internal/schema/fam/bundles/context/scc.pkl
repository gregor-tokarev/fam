/// scc: a code counter and complexity estimator (https://github.com/boyter/scc).
///
/// FAM installs the upstream release binary into ~/.local/bin.
/// Linux binaries are static and also run on musl.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "scc"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubRelease {
    repo = "boyter/scc"
    binary = "scc"
    assets {
      ["linux-amd64"] { name = "scc_Linux_x86_64.tar.gz"; format = "tar.gz"; file = "scc"; checksum = "checksums.txt" }
      ["linux-arm64"] { name = "scc_Linux_arm64.tar.gz"; format = "tar.gz"; file = "scc"; checksum = "checksums.txt" }
      ["darwin-arm64"] { name = "scc_Darwin_arm64.tar.gz"; format = "tar.gz"; file = "scc"; checksum = "checksums.txt" }
    }
  }
}

verify {
  new { name = "version"; script = "scc --version" }
}
