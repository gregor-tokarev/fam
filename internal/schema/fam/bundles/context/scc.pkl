/// scc: a code counter and complexity estimator (https://github.com/boyter/scc).
///
/// FAM uses the system package manager where this tool is packaged.
/// Other platforms use the Go package github.com/boyter/scc/v4.
/// Go must exist. FAM builds the CLI into ~/.local/bin.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

local systemPackage = packages.system(new Mapping {
  ["apk"] = "scc"
  ["brew"] = "scc"
})

name = "scc"
description = "Count source lines and estimate code complexity with structured output"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("scc", "boyter/scc")
  new fam.Package {
    package = systemPackage ?? new fam.PackageRef { package = "github.com/boyter/scc/v4"; manager = "go" }
    binary = "scc"
  }
}

verify {
  new { name = "version"; script = "scc --version" }
}

uninstall { packages.retireRelease("scc", "boyter/scc") }
