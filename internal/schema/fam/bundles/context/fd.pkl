/// fd: a file search tool (https://github.com/sharkdp/fd).
///
/// FAM uses the system package manager where this tool is packaged.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages
import "../../facts.pkl"

name = "fd"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("fd", "sharkdp/fd")
  new fam.Package {
    package = new fam.PackageRef {
      package = "fd"
      manager = "system"
      names {
        ["apt"] = "fd-find"
        ["dnf"] = "fd-find"
        ["pacman"] = "fd"
        ["apk"] = "fd"
        ["brew"] = "fd"
      }
    }
    binary = if (facts.distro == "ubuntu" || facts.distro == "debian") "fdfind" else "fd"
  }
  when (facts.distro == "ubuntu" || facts.distro == "debian") {
    packages.releaseAlias("fd", "sharkdp/fd", "/usr/bin/fdfind")
  }
}

verify {
  new { name = "version"; script = "fd --version" }
}

uninstall {
  packages.retireRelease("fd", "sharkdp/fd")
  when (facts.distro == "ubuntu" || facts.distro == "debian") {
    new fam.Symlink { path = "~/.local/bin/fd"; target = "/usr/bin/fdfind"; state = "absent" }
  }
}
