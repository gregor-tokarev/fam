/// ripgrep: a fast text search tool with ignore-file support (https://github.com/BurntSushi/ripgrep).
///
/// FAM uses the system package manager where this tool is packaged.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam
import "../packages.pkl" as packages

name = "ripgrep"
description = "Search source trees with fast regular expressions and ignore-file support"
version = "@FAM_VERSION@"
tasks {
  packages.retireRelease("rg", "BurntSushi/ripgrep")
  new fam.Package {
    package = new fam.PackageRef {
      package = "ripgrep"
      manager = "system"
      names {
        ["apt"] = "ripgrep"
        ["dnf"] = "ripgrep"
        ["pacman"] = "ripgrep"
        ["apk"] = "ripgrep"
        ["brew"] = "ripgrep"
      }
    }
    binary = "rg"
  }
}

verify {
  new { name = "version"; script = "rg --version" }
}

uninstall { packages.retireRelease("rg", "BurntSushi/ripgrep") }
