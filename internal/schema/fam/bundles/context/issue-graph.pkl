/// issue-graph: finds related issues, competing changes, and open follow-ups before work starts
/// (https://github.com/vercel-labs/issue-graph).
///
/// FAM installs the CLI with the global npm of the machine, and copies the skill of its latest
/// release from GitHub. To use another package manager, set `packageManagers` in `config.pkl`.
/// issue-graph uses the login of the GitHub CLI (`gh auth login`).
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "issue-graph"
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = "issue-graph"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/issue-graph"
    path = "skills/issue-graph"
  }
}

verify {
  // issue-graph has no --version.
  new { name = "issue-graph --help"; script = "issue-graph --help >/dev/null" }
}
