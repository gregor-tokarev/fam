/// repomix: a tool that packs repository content for model context (https://github.com/yamadashy/repomix).
///
/// FAM installs repomix with npm.
/// The CLI needs Node.js >=22.0.0.
/// FAM copies the core skills from the upstream repository.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "repomix"
description = "Pack local or remote source repositories into context for coding agents."
version = "@FAM_VERSION@"
tasks {
  new fam.Package {
    package = "repomix"
    binary = "repomix"
  }
  new fam.GitHubSkill {
    repo = "yamadashy/repomix"
    path = "skills/repomix-explorer"
  }
}

verify {
  new { name = "version"; script = "repomix --version" }
}
