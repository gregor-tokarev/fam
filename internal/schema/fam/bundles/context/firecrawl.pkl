/// firecrawl: a CLI for web search, scraping, and crawling (https://github.com/firecrawl/cli).
///
/// FAM installs firecrawl-cli with npm.
/// The CLI needs Node.js >=22.0.0.
/// Credentials: FIRECRAWL_API_KEY.
/// FAM copies the core skills from the upstream repository.
amends "../../Bundle.pkl"

import "../../tasks.pkl" as fam

name = "firecrawl"
version = "@FAM_VERSION@"
requiredSecrets { "FIRECRAWL_API_KEY" }
tasks {
  new fam.Package {
    package = "firecrawl-cli"
    binary = "firecrawl"
    versionCommand = "FIRECRAWL_NO_UPDATE_CHECK=1 firecrawl --version"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-agent"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-alexandria"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-crawl"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-developer-index"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-download"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-interact"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-map"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-monitor"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-parse"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-research-index"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-scrape"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl-search"
  }
  new fam.AgentSkill {
    source = "https://github.com/firecrawl/cli"
    path = "skills/firecrawl"
  }
}

verify {
  new { name = "version"; script = "FIRECRAWL_NO_UPDATE_CHECK=1 firecrawl --version" }
}
