//! Written by FAM @FAM_VERSION@. Do not edit. Run `fam migrate` to update.

/// The official agent skills of Vercel (https://github.com/vercel-labs/agent-skills): React,
/// React Native, web design, writing, and Vercel deployments. Only skills, no CLI.
amends "../Bundle.pkl"

import "../tasks.pkl" as fam

name = "agent-skills"
description = "Vercel agent skills"
version = "@FAM_VERSION@"
tasks {
  new fam.GitHubSkill {
    repo = "vercel-labs/agent-skills"
    path = "skills/composition-patterns"
    name = "vercel-composition-patterns"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/agent-skills"
    path = "skills/deploy-to-vercel"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/agent-skills"
    path = "skills/react-best-practices"
    name = "vercel-react-best-practices"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/agent-skills"
    path = "skills/react-native-skills"
    name = "vercel-react-native-skills"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/agent-skills"
    path = "skills/react-view-transitions"
    name = "vercel-react-view-transitions"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/agent-skills"
    path = "skills/vercel-cli-with-tokens"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/agent-skills"
    path = "skills/vercel-optimize"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/agent-skills"
    path = "skills/web-design-guidelines"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/agent-skills"
    path = "skills/writing-guidelines"
  }
}
