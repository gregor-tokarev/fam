/// The machines of the fleet, in a separate file.
///
/// ```
/// amends "@fam/Machines.pkl"
///
/// machines {
///   ["laptop"] { cockpit = true }
///   ["worker1"] { tags { "worker"; "gpu" }; address = "worker1.example.com"; user = "dev" }
/// }
/// ```
///
/// `config.pkl` uses it with `machines = import("machines.pkl").machines`.
module fam.Machines

import "base.pkl"

/// The machines of the fleet. The key is the machine name.
machines: Mapping<String(matches(Regex("[A-Za-z0-9][A-Za-z0-9._-]*"))), base.Machine>
