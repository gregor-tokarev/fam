/// Tools that let agents use a computer: browsers and desktop apps.
module fam.std.computer

import "../Bundle.pkl"

/// agent-browser: a browser automation CLI for agents, with its skill.
function agentBrowser(): Bundle = import("../bundles/computer/agent-browser.pkl")

/// agent-desktop: computer use for agents through the accessibility tree, with its skills.
function agentDesktop(): Bundle = import("../bundles/computer/agent-desktop.pkl")

/// browser-use: Browser control CLI with local and hosted browser sessions.
function browserUse(): Bundle = import("../bundles/computer/browser-use.pkl")

/// playwright-cli: Browser automation CLI for coding agents, from Microsoft.
function playwrightCli(): Bundle = import("../bundles/computer/playwright-cli.pkl")
