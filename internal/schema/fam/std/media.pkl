/// Tools that make media: video, images, and text.
module fam.std.media

import "../Bundle.pkl"

/// ai-cli: generate text, images, and more from the terminal, with its skill.
function aiCli(): Bundle = import("../bundles/media/ai-cli.pkl")

/// HyperFrames: HTML to video, with the core skills.
function hyperframes(): Bundle = import("../bundles/media/hyperframes.pkl")

/// webreel: scripted browser demos as video, with its skill.
function webreel(): Bundle = import("../bundles/media/webreel.pkl")

/// agg: Official renderer that converts asciinema recordings to GIF files.
function agg(): Bundle = import("../bundles/media/agg.pkl")

/// asciinema: Terminal recording CLI with a headless mode for scripts and CI.
function asciinema(): Bundle = import("../bundles/media/asciinema.pkl")

/// d2: Official text to diagram CLI for architecture and system designs.
function d2(): Bundle = import("../bundles/media/d2.pkl")

/// elevenlabs: Official ElevenLabs CLI for speech, audio, media generation, and API access.
function elevenlabs(): Bundle = import("../bundles/media/elevenlabs.pkl")

/// fal: Official fal CLI for model API calls, generation queues, and deployments.
function fal(): Bundle = import("../bundles/media/fal.pkl")

/// ffmpeg: Official command line tools for video, audio, and media conversion.
function ffmpeg(): Bundle = import("../bundles/media/ffmpeg.pkl")

/// imagemagick: Official CLI for image conversion, resizing, comparison, and composition.
function imageMagick(): Bundle = import("../bundles/media/imagemagick.pkl")

/// mermaid-cli: Official CLI that renders Mermaid diagrams to SVG, PNG, and PDF.
function mermaidCli(): Bundle = import("../bundles/media/mermaid-cli.pkl")

/// oxipng: Lossless PNG optimization CLI with parallel processing.
function oxipng(): Bundle = import("../bundles/media/oxipng.pkl")

/// remotion-cli: Official Remotion CLI for headless video and still image rendering.
function remotionCli(): Bundle = import("../bundles/media/remotion-cli.pkl")

/// resvg: Official standalone SVG renderer CLI with PNG output.
function resvg(): Bundle = import("../bundles/media/resvg.pkl")

/// svgo: Official SVG optimizer CLI for compact vector assets.
function svgo(): Bundle = import("../bundles/media/svgo.pkl")

/// vhs: Scripted terminal recording CLI that creates videos and GIFs.
function vhs(): Bundle = import("../bundles/media/vhs.pkl")

/// vips: Official image processing CLI for large images and batch operations.
function vips(): Bundle = import("../bundles/media/vips.pkl")

/// yt-dlp: Command line downloader for video, audio, subtitles, and metadata.
function ytDlp(): Bundle = import("../bundles/media/yt-dlp.pkl")
