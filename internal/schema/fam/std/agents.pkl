/// Tools for the agents themselves.
module fam.std.agents

import "../Bundle.pkl"

/// skills: the agent skills tool, with the find-skills skill.
skills: Bundle = import("../bundles/agents/skills.pkl")

/// daytona: Create and manage Daytona sandboxes, snapshots, and remote command execution.
daytona: Bundle = import("../bundles/agents/daytona.pkl")

/// e2b: Manage E2B cloud sandboxes and build sandbox templates.
e2b: Bundle = import("../bundles/agents/e2b.pkl")

/// modal: Deploy serverless jobs and manage Modal functions, sandboxes, volumes, and secrets.
modal: Bundle = import("../bundles/agents/modal.pkl")

/// promptfoo: Evaluate model prompts and agents, and run adversarial evaluations.
promptfoo: Bundle = import("../bundles/agents/promptfoo.pkl")
