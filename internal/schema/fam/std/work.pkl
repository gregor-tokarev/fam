/// Tools for daily work.
module fam.std.work

import "../Bundle.pkl"

/// linear-cli: Manage Linear issues, projects, cycles, documents, and comments.
function linearCli(): Bundle = import("../bundles/work/linear-cli.pkl")

/// slack-cli: Call Slack APIs and develop, run, and deploy Slack applications.
function slackCli(): Bundle = import("../bundles/work/slack-cli.pkl")

/// stripe-cli: Manage Stripe API resources, webhooks, and local payment integration workflows.
function stripeCli(): Bundle = import("../bundles/work/stripe-cli.pkl")
