/// Cloud platforms and their tools.
module fam.std.cloud

import "../Bundle.pkl"

/// aws-cli: manage AWS services with AWS CLI v2.
function awsCli(): Bundle = import("../bundles/cloud/aws-cli.pkl")

/// azure-cli: manage Azure resources and deployments.
function azureCli(): Bundle = import("../bundles/cloud/azure-cli.pkl")

/// cf: official Cloudflare CLI for its complete API.
function cloudflareCf(): Bundle = import("../bundles/cloud/cf.pkl")

/// crane: inspect, copy, and modify container images in registries.
function crane(): Bundle = import("../bundles/cloud/crane.pkl")

/// docker: build images and control local or remote Docker engines.
function docker(): Bundle = import("../bundles/cloud/docker.pkl")

/// doctl: manage DigitalOcean compute, Kubernetes, and platform resources.
function doctl(): Bundle = import("../bundles/cloud/doctl.pkl")

/// firebase: deploy Firebase applications and manage project resources.
function firebase(): Bundle = import("../bundles/cloud/firebase.pkl")

/// flyctl: deploy applications and manage Fly.io machines.
function flyctl(): Bundle = import("../bundles/cloud/flyctl.pkl")

/// google-agents-cli: create, evaluate, and deploy applications on Google Cloud.
function googleAgentsCli(): Bundle = import("../bundles/cloud/google-agents-cli.pkl")

/// hcloud: manage Hetzner Cloud servers, networks, and storage.
function hcloud(): Bundle = import("../bundles/cloud/hcloud.pkl")

/// helm: package and deploy applications on Kubernetes.
function helm(): Bundle = import("../bundles/cloud/helm.pkl")

/// kind: run local Kubernetes clusters in containers.
function kind(): Bundle = import("../bundles/cloud/kind.pkl")

/// kubectl: manage Kubernetes resources and clusters.
function kubectl(): Bundle = import("../bundles/cloud/kubectl.pkl")

/// kustomize: customize Kubernetes manifests without templates.
function kustomize(): Bundle = import("../bundles/cloud/kustomize.pkl")

/// netlify: deploy and manage Netlify sites.
function netlify(): Bundle = import("../bundles/cloud/netlify.pkl")

/// opentofu: plan and apply infrastructure changes with OpenTofu.
function openTofu(): Bundle = import("../bundles/cloud/opentofu.pkl")

/// podman: control containers through a Podman service.
function podman(): Bundle = import("../bundles/cloud/podman.pkl")

/// pulumi: manage cloud infrastructure through Pulumi programs.
function pulumi(): Bundle = import("../bundles/cloud/pulumi.pkl")

/// railway: deploy and manage Railway services and projects.
function railway(): Bundle = import("../bundles/cloud/railway.pkl")

/// render: deploy and manage Render services.
function render(): Bundle = import("../bundles/cloud/render.pkl")

/// terraform: plan and apply infrastructure changes with Terraform.
function terraform(): Bundle = import("../bundles/cloud/terraform.pkl")

/// vercel: deploy and manage Vercel projects.
function vercel(): Bundle = import("../bundles/cloud/vercel.pkl")

/// wrangler: develop and deploy Cloudflare Workers and related resources.
function wrangler(): Bundle = import("../bundles/cloud/wrangler.pkl")
