/// Cloud platforms and their tools.
module fam.std.cloud

import "../Bundle.pkl"

/// aws-cli: manage AWS services with AWS CLI v2.
function awsCli(): Bundle = import("../bundles/cloud/aws-cli.pkl")

/// azure-cli: manage Azure resources and deployments.
function azureCli(): Bundle = import("../bundles/cloud/azure-cli.pkl")

/// cf: official Cloudflare CLI for its complete API.
function cloudflareCf(): Bundle = import("../bundles/cloud/cf.pkl")

/// docker: build images and control local or remote Docker engines.
function docker(): Bundle = import("../bundles/cloud/docker.pkl")

/// flyctl: deploy applications and manage Fly.io machines.
function flyctl(): Bundle = import("../bundles/cloud/flyctl.pkl")

/// helm: package and deploy applications on Kubernetes.
function helm(): Bundle = import("../bundles/cloud/helm.pkl")

/// kubectl: manage Kubernetes resources and clusters.
function kubectl(): Bundle = import("../bundles/cloud/kubectl.pkl")

/// railway: deploy and manage Railway services and projects.
function railway(): Bundle = import("../bundles/cloud/railway.pkl")

/// terraform: plan and apply infrastructure changes with Terraform.
function terraform(): Bundle = import("../bundles/cloud/terraform.pkl")

/// vercel: deploy and manage Vercel projects.
function vercel(): Bundle = import("../bundles/cloud/vercel.pkl")

/// wrangler: develop and deploy Cloudflare Workers and related resources.
function wrangler(): Bundle = import("../bundles/cloud/wrangler.pkl")
