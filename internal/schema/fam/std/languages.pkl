/// Programming languages for agents.
module fam.std.languages

import "../Bundle.pkl"

/// Zero: the programming language for agents, with its skill.
function zero(): Bundle = import("../bundles/languages/zero.pkl")

/// pixi: Manage reproducible environments and command-line tools across language ecosystems.
function pixi(): Bundle = import("../bundles/languages/pixi.pkl")

/// pnpm: Install JavaScript packages and run workspace commands with a shared package store.
function pnpm(): Bundle = import("../bundles/languages/pnpm.pkl")

/// ruff: Lint and format Python code from a standalone command-line tool.
function ruff(): Bundle = import("../bundles/languages/ruff.pkl")

/// Rustup: manage Rust toolchains without a default compiler.
function rustup(): Bundle = import("../bundles/languages/rustup.pkl")

/// uv: Manage Python interpreters, packages, environments, and command-line tools.
function uv(): Bundle = import("../bundles/languages/uv.pkl")

/// Bun: run JavaScript and TypeScript with the Bun toolchain.
function bun(): Bundle = import("../bundles/languages/bun.pkl")

/// Deno: run JavaScript and TypeScript with the Deno toolchain.
function deno(): Bundle = import("../bundles/languages/deno.pkl")

/// Go: build and format Go programs with the Go toolchain.
function go(): Bundle = import("../bundles/languages/go.pkl")
