//! Written by FAM 0.8.0. Do not edit. Run `fam migrate` to update.

/// emulate: local emulation of APIs for CI and sandboxes without network (https://github.com/vercel-labs/emulate).
///
/// FAM installs the CLI with the global npm of the machine, and copies the skill of its latest
/// release from GitHub. To use another package manager, set `packageManagers` in `config.pkl`.
amends "../Bundle.pkl"

import "../tasks.pkl" as fam

name = "emulate"
description = "Local API emulation"
version = "0.8.0"
tasks {
  new fam.Package {
    package = "emulate"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/emulate"
    path = "skills/emulate"
  }
}

verify {
  new { name = "emulate --version"; script = "emulate --version" }
}
