//! Written by FAM 0.7.0. Do not edit. Run `fam migrate` to update.

/// portless: stable, named local URLs instead of port numbers (https://github.com/vercel-labs/portless).
///
/// FAM installs the CLI with the global npm of the machine, and copies the skill of its latest
/// release from GitHub. To use another package manager, set `packageManagers` in `config.pkl`.
/// portless needs Node.js 24 or later.
amends "../Bundle.pkl"

import "../tasks.pkl" as fam

name = "portless"
description = "Named local URLs instead of port numbers"
version = "0.7.0"
tasks {
  new fam.Package {
    package = "portless"
  }
  new fam.GitHubSkill {
    repo = "vercel-labs/portless"
    path = "skills/portless"
  }
}

verify {
  new { name = "portless --version"; script = "portless --version" }
}
