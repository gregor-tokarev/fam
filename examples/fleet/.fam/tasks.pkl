//! Written by FAM 0.2.0. Do not edit. Run `fam upgrade` to update.

/// The task types of FAM.
///
/// The task types of bundles.
/// Import this module with a different name, because `tasks` is also a property name:
///
/// ```
/// import "../.fam/tasks.pkl" as fam
/// ```
///
/// Paths that start with `~/` are relative to the home directory of the SSH user.
module fam.tasks

/// The wanted state of a bundle or a task.
///
/// - `"present"`: FAM installs or writes the item.
/// - `"absent"`: FAM removes the item.
typealias State = "present"|"absent"

/// The base class of all tasks.
abstract class Task {
  /// Run the task with `sudo`.
  ///
  /// On a worker, FAM runs `sudo -n`. On the cockpit, FAM asks for the password once.
  sudo: Boolean = false

  /// Units that FAM restarts once, at the end of the bundle, when this task made a change.
  ///
  /// FAM does not restart units after a failed task.
  /// FAM does not restart units for a bundle with the state `"absent"`.
  /// A unit managed by a [Service] task in the same bundle uses the scope of that task (when the
  /// bundle has a user and a system Service task with this name, the rule below applies).
  /// Other units use the system scope when [sudo] is `true`, and the user scope when it is `false`.
  restarts: Listing<String>
}

/// A task that FAM can also undo.
abstract class StateTask extends Task {
  /// The wanted state.
  ///
  /// When a bundle has the state `"absent"`, FAM undoes all its typed tasks.
  state: State = "present"
}

/// A file with a fixed content.
///
/// ```
/// new fam.File {
///   path = "~/.local/bin/hello"
///   content = read("files/hello.sh").text
///   mode = "0755"
/// }
/// ```
class File extends StateTask {
  /// The path of the file on the machine.
  path: String

  /// The full content of the file. Required when [state] is `"present"`; FAM stops otherwise.
  content: String?

  /// The file mode as an octal string, for example `"0644"`.
  mode: String(matches(Regex("0?[0-7]{3}"))) = "0644"
}

/// Keys merged into a JSON or TOML file.
///
/// FAM keeps all other keys of the file.
/// When [state] is `"absent"`, FAM removes the keys of [values] from the file.
///
/// ```
/// new fam.Merge {
///   path = "~/.cargo/config.toml"
///   format = "toml"
///   values { build { jobs = 4 } }
/// }
/// ```
class Merge extends StateTask {
  /// The path of the file on the machine.
  path: String

  /// The format of the file.
  format: "json"|"toml"

  /// The keys to merge. Nested objects merge recursively. Lists replace the old value.
  values: Dynamic

  /// The mode of a new file.
  mode: String(matches(Regex("0?[0-7]{3}"))) = "0644"
}

/// A symbolic link.
class Symlink extends StateTask {
  /// The path of the link.
  path: String

  /// The target of the link.
  target: String
}

/// A system service: a systemd unit on Linux, a launchd job on macOS.
///
/// FAM stops with an error on a machine without systemd or launchd.
class Service extends StateTask {
  /// The unit name, for example `"fleet-ports.service"`, or the launchd label.
  name: String

  /// `"user"` for a user unit or a LaunchAgent. `"system"` for a system unit or a LaunchDaemon.
  ///
  /// System units need `sudo = true`.
  scope: "user"|"system" = "user"

  /// The unit file or the launchd property list.
  ///
  /// When it is `null`, FAM does not write a file and only enables and starts the unit.
  content: String?

  /// Start the unit at boot or login.
  enabled: Boolean = true

  /// Keep the unit running.
  running: Boolean = true
}

/// Lingering for the SSH user on Linux, so that user units run without a login session.
///
/// The default of [sudo] is `true`, because `loginctl enable-linger` usually needs root.
class Linger extends StateTask {
  sudo = true

  /// The user. When it is `null`, FAM uses the SSH user.
  user: String?
}

/// A package manager for [Package.package].
///
/// - `"npm"`, `"bun"`, `"vite"` (Vite+ `vp install -g`): global JavaScript packages, as the user.
/// - `"brew"`: Homebrew, as the user.
/// - `"apt"`, `"dnf"`, `"pacman"`, `"apk"`: the OS package manager. FAM runs it with `sudo`.
/// - `"yay"`: AUR packages on Arch Linux, as the user (yay runs `sudo` itself).
typealias Manager = "npm"|"bun"|"vite"|"brew"|"apt"|"dnf"|"pacman"|"yay"|"apk"

/// A package with its package manager.
///
/// ```
/// package = new { package = "agent-browser"; manager = "brew" }
/// ```
class PackageRef {
  /// The package name, for example `"agent-browser"` or `"@railway/cli"`.
  package: String

  /// The package manager.
  manager: Manager = "npm"
}

/// A command line program.
///
/// Give a [package], and FAM installs, updates, and removes it with a package manager:
///
/// ```
/// new fam.Package { package = "agent-browser" }                                   // npm
/// new fam.Package { package = new { package = "agent-browser"; manager = "brew" } }
/// ```
///
/// Or give your own commands: [install], [update], [uninstall].
///
/// FAM installs the program when it is missing, and updates it on each `fam apply`.
/// An update changes nothing in the result when the output of [versionCommand] stays the same.
class Package extends StateTask {
  /// The package. A string is an npm package. An object (`new { package = …; manager = … }`
  /// or a [PackageRef]) selects the package manager.
  package: (String|PackageRef|Dynamic)?

  /// The name of the program in `PATH`, or its path (for example `"~/.local/bin/tool"`).
  ///
  /// When it is `null`, FAM uses the package name without its npm scope (`@railway/cli` gives `cli`).
  binary: String?

  /// The install command. Required when [package] is `null`.
  install: String?((this != null) || (package != null))

  /// The update command. When it is `null` and [package] is `null`, FAM does not update the program.
  update: String?

  /// The uninstall command. Required to remove a package without [package].
  uninstall: String?

  /// A command that prints the installed version. When it is `null`, FAM runs `<binary> --version`.
  versionCommand: String?
}

/// A shell script with a check.
///
/// FAM cannot undo a script.
///
/// Exit codes of [check]:
/// - `0`: satisfied. FAM does not run [apply].
/// - `100`: changes required. FAM runs [apply], then runs [check] again.
/// - any other code: error. FAM never runs [apply] after an error.
///
/// FAM rejects a script without [check] or [creates].
class Script extends Task {
  /// The name of the script in output.
  name: String

  /// The check command. See the exit codes above.
  check: String?

  /// A short form of a check: the script is satisfied when this path exists.
  creates: String?

  /// The apply command.
  apply: String(check != null || creates != null)
}
