//! Written by FAM 0.7.0. Do not edit. Run `fam migrate` to update.

/// Facts about the machine that FAM evaluates the config for.
///
/// FAM collects the facts over SSH before evaluation and gives them to Pkl
/// as external properties `fam.<name>`. To evaluate a config by hand:
///
/// ```
/// pkl eval -p fam.os=linux -p fam.cpus=8 … config.pkl
/// ```
module fam.facts

/// The machine name: the key in `machines`.
machine: String = read("prop:fam.machine")

/// The role of the machine: `"cockpit"` or `"worker"`.
role: String = read("prop:fam.role")

/// The operating system: `"linux"` or `"darwin"`.
os: String = read("prop:fam.os")

/// The distribution ID from `/etc/os-release`, for example `"ubuntu"`, `"debian"`, `"fedora"`,
/// `"arch"`, `"alpine"`. On macOS: `"macos"`.
distro: String = read("prop:fam.distro")

/// The distribution version, for example `"24.04"`. It can be empty, for example on Arch Linux.
distroVersion: String = read("prop:fam.distroVersion")

/// The CPU architecture: `"amd64"` or `"arm64"`.
arch: String = read("prop:fam.arch")

/// The number of CPU cores.
cpus: Int = read("prop:fam.cpus").toInt()

/// The home directory of the SSH user.
home: String = read("prop:fam.home")

/// The SSH user.
user: String = read("prop:fam.user")

/// The host name that the machine reports.
hostname: String = read("prop:fam.hostname")

/// The service manager: `"systemd"`, `"launchd"`, or `"none"`.
init: String = read("prop:fam.init")

/// The login shell of the SSH user, for example `"/bin/bash"`.
shell: String = read("prop:fam.shell")
