//! Written by FAM 0.8.0. Do not edit. Run `fam migrate` to update.

/// The standard bundles of FAM 0.8.0.
///
/// ```
/// import ".fam/std.pkl"
///
/// bundles { std.agentBrowser; std.portless }
/// ```
module fam.std

import "Bundle.pkl"

/// agent-browser: a browser automation CLI for agents, with its skill.
agentBrowser: Bundle = import("bundles/agent-browser.pkl")

/// agent-desktop: computer use for agents through the accessibility tree, with its skills.
agentDesktop: Bundle = import("bundles/agent-desktop.pkl")

/// ai-cli: generate text, images, and more from the terminal, with its skill.
aiCli: Bundle = import("bundles/ai-cli.pkl")

/// emulate: local API emulation for CI and sandboxes, with its skill.
emulate: Bundle = import("bundles/emulate.pkl")

/// HyperFrames: HTML to video, with the core skills.
hyperframes: Bundle = import("bundles/hyperframes.pkl")

/// issue-graph: related issues and changes before work starts, with its skill.
issueGraph: Bundle = import("bundles/issue-graph.pkl")

/// lat.md: a Markdown knowledge graph of a codebase, with its skill.
latMd: Bundle = import("bundles/lat-md.pkl")

/// opensrc: the source code of npm packages for agents, with its skill.
opensrc: Bundle = import("bundles/opensrc.pkl")

/// portless: named local URLs instead of port numbers, with its skill.
portless: Bundle = import("bundles/portless.pkl")

/// skills: the agent skills tool, with the find-skills skill.
skills: Bundle = import("bundles/skills.pkl")

/// webreel: scripted browser demos as video, with its skill.
webreel: Bundle = import("bundles/webreel.pkl")

/// Zero: the programming language for agents, with its skill.
zero: Bundle = import("bundles/zero.pkl")
