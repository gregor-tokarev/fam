amends "@fam/Bundle.pkl"
import "@fam/tasks.pkl" as fam

name = "typescript"

tasks {
  // Node.js comes from Vite+, so TypeScript is a global package of Vite+.
  new fam.Package {
    package = new { package = "typescript"; manager = "vite" }
    binary = "tsc"
  }
}

verify {
  new { event = "fresh_shell"; script = "tsc --version" }
}
