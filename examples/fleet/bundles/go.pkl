amends "@fam/Bundle.pkl"
import "@fam/tasks.pkl" as fam
import "@fam/facts.pkl"

name = "go"

tasks {
  new fam.Package {
    binary = "go"
    sudo = facts.os == "linux"
    install =
      if (facts.os == "darwin") "brew install go"
      else if (facts.distro == "fedora") "dnf install -y golang"
      else if (facts.distro == "arch") "pacman -S --needed --noconfirm go"
      else "DEBIAN_FRONTEND=noninteractive apt-get install -y golang-go"
    versionCommand = "go version"
  }
}

verify {
  new { event = "fresh_shell"; script = "go version" }
}
